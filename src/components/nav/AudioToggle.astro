---
import { type Lang, useTranslations } from "@/i18n/ui";

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<button
  class="nav__audio"
  id="navAudio"
  aria-pressed="false"
  aria-label={t("audio.label")}
  title={t("audio.label")}
>
  <span class="bars" aria-hidden="true">
    <span></span><span></span><span></span>
  </span>
  <svg class="cross" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" aria-hidden="true">
    <path d="M6 6l12 12M18 6L6 18"/>
  </svg>
</button>

<style>
  .nav__audio {
    position: relative;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    border: 1px solid rgba(247, 243, 236, 0.35);
    transition: border-color 0.35s, background 0.35s, transform 0.35s;
  }
  .nav__audio:hover {
    border-color: #f7f3ec;
    transform: scale(1.05);
  }
  :global(.nav.scrolled) .nav__audio { border-color: rgba(21, 17, 13, 0.25); }
  :global(.nav.scrolled) .nav__audio:hover { border-color: var(--color-ink); }

  /* shared centering for both states */
  .nav__audio .bars,
  .nav__audio .cross {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    transition: opacity 0.35s var(--ease-editorial), transform 0.4s var(--ease-editorial);
  }

  /* PAUSED state — X visible, bars hidden */
  .nav__audio[aria-pressed="false"] .cross {
    opacity: 1;
    transform: translate(-50%, -50%) rotate(0deg) scale(1);
  }
  .nav__audio[aria-pressed="false"] .bars {
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.7);
    pointer-events: none;
  }

  /* PLAYING state — bars visible, X hidden */
  .nav__audio[aria-pressed="true"] .cross {
    opacity: 0;
    transform: translate(-50%, -50%) rotate(90deg) scale(0.6);
    pointer-events: none;
  }
  .nav__audio[aria-pressed="true"] .bars {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
  }

  /* X icon */
  .nav__audio .cross {
    width: 14px;
    height: 14px;
    color: #f7f3ec;
  }
  :global(.nav.scrolled) .nav__audio .cross { color: var(--color-ink); }

  /* equalizer bars */
  .nav__audio .bars {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2.5px;
    width: 14px;
    height: 12px;
  }
  .nav__audio .bars span {
    position: static;
    transform: none;
    transition: none;
    display: block;
    width: 2px;
    height: 3px;
    background: #f7f3ec;
  }
  :global(.nav.scrolled) .nav__audio .bars span { background: var(--color-ink); }

  .nav__audio[aria-pressed="true"] .bars span {
    animation: eq 1.1s ease-in-out infinite;
  }
  .nav__audio[aria-pressed="true"] .bars span:nth-child(1) { animation-delay: 0s; }
  .nav__audio[aria-pressed="true"] .bars span:nth-child(2) { animation-delay: 0.18s; }
  .nav__audio[aria-pressed="true"] .bars span:nth-child(3) { animation-delay: 0.36s; }

  @keyframes eq {
    0%, 100% { height: 3px; }
    50% { height: 11px; }
  }
</style>
