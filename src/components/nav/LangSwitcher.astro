---
import { type Lang } from "@/i18n/ui";
import { localizedPath } from "@/i18n/utils";

interface Props { lang: Lang }
const { lang } = Astro.props;

// Cada botón apunta SIEMPRE al home de su idioma — ES → "/", EN → "/en/".
// El active state se calcula contra la lang actual, pero el destino del
// link es fijo, así clickear ES desde EN te lleva a ES (y viceversa).
const esHref = localizedPath("es", "/");
const enHref = localizedPath("en", "/");
---

<div class="lang">
  <a
    href={esHref}
    class:list={["lang__btn", lang === "es" && "active"]}
    aria-current={lang === "es" ? "true" : undefined}
  >ES</a>
  <span aria-hidden="true">/</span>
  <a
    href={enHref}
    class:list={["lang__btn", lang === "en" && "active"]}
    aria-current={lang === "en" ? "true" : undefined}
  >EN</a>
</div>

<style>
  .lang {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 11px;
    letter-spacing: 0.16em;
  }
  .lang__btn {
    color: rgba(21, 17, 13, 0.45);
    font-weight: 400;
    transition: color 0.35s;
    padding: 4px 2px;
  }
  .lang__btn.active { color: var(--color-ink); }
  .lang span { color: rgba(21, 17, 13, 0.3); }
</style>
