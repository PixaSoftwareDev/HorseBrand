---
import { type Lang, useTranslations } from "@/i18n/ui";
import { localizedPath } from "@/i18n/utils";

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const home = localizedPath(lang, "/");
---

<div class="mobile-menu" id="mobileMenu" aria-hidden="true">
  <a href={`${home}#manifiesto`}>{t("nav.manifesto")}</a>
  <a href={`${home}#coleccion`}>{t("nav.collection")}</a>
  <a href={`${home}#galeria`}>{t("nav.gallery")}</a>
  <a href={`${home}#artesania`}>{t("nav.craft")}</a>
  <a href={`${home}#contacto`}>{t("nav.contact")}</a>
</div>

<style>
  .mobile-menu {
    position: fixed;
    top: 0;
    right: -100%;
    width: 82%;
    max-width: 380px;
    height: 100vh;
    height: 100dvh;
    background: var(--color-ivory);
    z-index: 110;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 28px;
    transition: right 0.55s var(--ease-editorial);
    padding: 0 30px;
    overflow-y: auto;
  }
  .mobile-menu.open { right: 0; }
  .mobile-menu a {
    font-family: var(--font-display);
    font-size: clamp(22px, 6vw, 28px);
    letter-spacing: 0.02em;
    color: var(--color-ink);
    line-height: 1.2;
  }
  @media (max-width: 360px) {
    .mobile-menu { gap: 22px; }
    .mobile-menu a { font-size: 22px; }
  }
</style>
