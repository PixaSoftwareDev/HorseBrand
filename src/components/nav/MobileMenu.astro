---
import { type Lang, useTranslations } from "@/i18n/ui";
import { localizedPath } from "@/i18n/utils";

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const home = localizedPath(lang, "/");
---

<div class="mobile-menu" id="mobileMenu" aria-hidden="true">
  <button class="mobile-menu__close" id="mobileMenuClose" aria-label="Close menu" type="button">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" aria-hidden="true">
      <path d="M6 6l12 12M18 6L6 18"/>
    </svg>
  </button>
  <a href={`${home}#manifiesto`}>{t("nav.manifesto")}</a>
  <a href={`${home}#coleccion`}>{t("nav.collection")}</a>
  <a href={`${home}#galeria`}>{t("nav.gallery")}</a>
  <a href={`${home}#artesania`}>{t("nav.craft")}</a>
  <a href={`${home}#contacto`}>{t("nav.contact")}</a>
</div>

<style>
  .mobile-menu {
    position: fixed;
    top: 0;
    right: -100%;
    width: 82%;
    max-width: 380px;
    height: 100vh;
    height: 100dvh;
    background: var(--color-ivory);
    z-index: 110;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 28px;
    transition: right 0.55s var(--ease-editorial);
    padding: 0 30px;
    overflow-y: auto;
  }
  .mobile-menu.open { right: 0; }
  .mobile-menu a {
    font-family: var(--font-display);
    font-size: clamp(22px, 6vw, 28px);
    letter-spacing: 0.02em;
    color: var(--color-ink);
    line-height: 1.2;
  }

  /* X close button — top-right corner of the panel */
  .mobile-menu__close {
    position: absolute;
    top: 22px;
    right: 22px;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid rgba(21, 17, 13, 0.18);
    background: transparent;
    color: var(--color-ink);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition:
      background 0.4s var(--ease-editorial),
      border-color 0.4s,
      color 0.4s,
      transform 0.4s var(--ease-soft);
    z-index: 2;
  }
  .mobile-menu__close:hover,
  .mobile-menu__close:active {
    background: var(--color-ink);
    border-color: var(--color-ink);
    color: var(--color-ivory);
    transform: rotate(90deg);
  }
  .mobile-menu__close svg { width: 18px; height: 18px; }

  @media (max-width: 360px) {
    .mobile-menu { gap: 22px; }
    .mobile-menu a { font-size: 22px; }
    .mobile-menu__close { top: 18px; right: 18px; width: 40px; height: 40px; }
  }
</style>
