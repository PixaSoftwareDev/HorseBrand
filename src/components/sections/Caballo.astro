---
import { type Lang, useTranslations } from "@/i18n/ui";
import { cldImage } from "@/lib/cloudinary";
import { CLD_IDS } from "@/lib/cloudinaryAssets";

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);

// Close-up image clipped INSIDE the giant "CABALLO" lettering via
// background-clip: text. We request a fairly wide rendering so the texture
// reads sharp inside the letter masks at any viewport.
const horseImg = cldImage(CLD_IDS.IMG_3106, 2800);

const keywords = ["caballo.word_1", "caballo.word_2", "caballo.word_3", "caballo.word_4"] as const;

// The mega word that gets the image-inside-text treatment. We keep it as
// a single word for the strongest possible typographic anchor.
const megaWord = lang === "es" ? "Caballo" : "Horse";
---

<section class="caballo" id="caballo" aria-label={t("caballo.eyebrow")}>
  <div class="caballo__inner">
    <span class="caballo__eyebrow" data-cab-rev>{t("caballo.eyebrow")}</span>

    <!-- Type lockup — the image lives INSIDE the letters via background-clip: text.
         A screen-reader-only span carries the readable copy for a11y. -->
    <h2
      class="caballo__mega"
      style={`background-image: url('${horseImg}')`}
      aria-label={`${t("caballo.eyebrow")} · ${t("caballo.title_1")} ${t("caballo.title_2")}`}
      data-cab-rev
    >
      <span aria-hidden="true">{megaWord}</span>
    </h2>

    <p class="caballo__phrase" data-cab-rev>
      <span>{t("caballo.title_1")}</span>
      <em>{t("caballo.title_2")}</em>
    </p>

    <ul class="caballo__keywords" aria-hidden="true" data-cab-rev>
      {keywords.map((k, i) => (
        <li style={`--i:${i}`}>{t(k as any)}</li>
      ))}
    </ul>

    <p class="caballo__closer" data-cab-rev>{t("caballo.closer")}</p>
  </div>
</section>

<script>
  import { onPageReady } from "@/lib/onPageReady";

  /**
   * Caballo — staggered reveal of every element marked [data-cab-rev].
   * The CSS handles the starting state (clipped/opacity 0) and the
   * .is-revealed state. We just toggle the class via IntersectionObserver.
   */
  function wireCaballo(): void {
    const section = document.querySelector<HTMLElement>(".caballo");
    if (!section || section.dataset.wired === "1") return;
    section.dataset.wired = "1";

    const targets = section.querySelectorAll<HTMLElement>("[data-cab-rev]");
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e, i) => {
          if (e.isIntersecting) {
            // Add staggered delay per element so reveals don't fire all at once
            const idx = Array.from(targets).indexOf(e.target as HTMLElement);
            (e.target as HTMLElement).style.transitionDelay = `${idx * 0.12}s`;
            e.target.classList.add("is-revealed");
            io.unobserve(e.target);
          }
        });
      },
      { threshold: 0.25 }
    );
    targets.forEach((el) => io.observe(el));

    document.addEventListener(
      "astro:before-swap",
      () => io.disconnect(),
      { once: true }
    );
  }
  onPageReady(wireCaballo);
</script>

<style>
  .caballo {
    position: relative;
    background: var(--color-paper);
    color: var(--color-ink);
    padding: 18vh 5vw 14vh;
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .caballo__inner {
    width: 100%;
    max-width: 1500px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0;
  }

  /* ---- Eyebrow ---- */
  .caballo__eyebrow {
    font-family: var(--font-sans);
    font-size: 11px;
    letter-spacing: 0.5em;
    text-transform: uppercase;
    color: var(--color-cognac);
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 1s var(--ease-editorial), transform 1s var(--ease-editorial);
    margin-bottom: 32px;
  }
  .caballo__eyebrow.is-revealed { opacity: 1; transform: translateY(0); }

  /* ---- MEGA word with the image inside the letters ----
   * `background-clip: text` makes the image visible only inside the glyphs.
   * A fallback color is provided in case the browser doesn't support it.
   * The letters are tightly tracked (-0.03em) so the photo reads cleanly. */
  .caballo__mega {
    font-family: var(--font-display);
    font-size: clamp(96px, 22vw, 340px);
    font-weight: 400;
    line-height: 0.86;
    letter-spacing: -0.03em;
    margin: 0;
    text-transform: uppercase;
    color: var(--color-ink);
    /* Image fill — falls through to color above if unsupported. */
    background-size: cover;
    background-position: center 35%;
    background-repeat: no-repeat;
    -webkit-background-clip: text;
    background-clip: text;
    /* Reveal mask — letters rise into view */
    clip-path: inset(100% 0 0 0);
    -webkit-clip-path: inset(100% 0 0 0);
    transition: clip-path 1.6s var(--ease-editorial);
    will-change: clip-path, background-position;
  }
  @supports (-webkit-background-clip: text) or (background-clip: text) {
    .caballo__mega {
      -webkit-text-fill-color: transparent;
    }
  }
  .caballo__mega.is-revealed {
    clip-path: inset(0 0 0 0);
    -webkit-clip-path: inset(0 0 0 0);
  }
  /* Sub-pixel rendering quality */
  .caballo__mega > span { display: inline-block; }

  /* ---- Phrase under the lockup ---- */
  .caballo__phrase {
    margin: 38px 0 0;
    font-family: var(--font-display);
    font-size: clamp(20px, 2vw, 30px);
    line-height: 1.3;
    letter-spacing: 0.005em;
    color: var(--color-ink);
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 1s var(--ease-editorial), transform 1s var(--ease-editorial);
  }
  .caballo__phrase.is-revealed { opacity: 1; transform: translateY(0); }
  .caballo__phrase em {
    font-family: var(--font-italic);
    font-style: italic;
    font-weight: 300;
    color: var(--color-cognac);
  }

  /* ---- Keywords · single horizontal line, dash separators in gold ---- */
  .caballo__keywords {
    margin: 40px 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 18px 32px;
    font-family: var(--font-sans);
    font-size: 11px;
    letter-spacing: 0.42em;
    text-transform: uppercase;
    color: var(--color-stone);
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 1.1s var(--ease-editorial), transform 1.1s var(--ease-editorial);
  }
  .caballo__keywords.is-revealed { opacity: 1; transform: translateY(0); }
  .caballo__keywords li {
    position: relative;
    transition: color 0.4s, transform 0.4s var(--ease-soft);
  }
  .caballo__keywords li::before {
    content: "—";
    margin-right: 12px;
    color: var(--color-gold);
  }
  .caballo__keywords li:hover {
    color: var(--color-ink);
    transform: translateY(-2px);
  }

  /* ---- Closer ---- */
  .caballo__closer {
    margin: 48px 0 0;
    font-family: var(--font-italic);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(15px, 1.2vw, 18px);
    line-height: 1.5;
    color: rgba(21, 17, 13, 0.6);
    max-width: 480px;
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 1s var(--ease-editorial), transform 1s var(--ease-editorial);
  }
  .caballo__closer.is-revealed { opacity: 1; transform: translateY(0); }

  /* ---- Reduced motion ---- */
  @media (prefers-reduced-motion: reduce) {
    .caballo__eyebrow,
    .caballo__mega,
    .caballo__phrase,
    .caballo__keywords,
    .caballo__closer {
      opacity: 1 !important;
      transform: none !important;
      clip-path: inset(0 0 0 0) !important;
      -webkit-clip-path: inset(0 0 0 0) !important;
      transition: none !important;
    }
  }

  /* ---- Mobile · tighter padding, slightly smaller mega ---- */
  @media (max-width: 800px) {
    .caballo { padding: 110px 5vw 90px; min-height: auto; }
    .caballo__mega { font-size: clamp(72px, 26vw, 180px); letter-spacing: -0.02em; }
    .caballo__phrase { margin-top: 28px; }
    .caballo__keywords { gap: 12px 20px; font-size: 10px; letter-spacing: 0.32em; }
    .caballo__keywords li::before { margin-right: 8px; }
    .caballo__closer { margin-top: 36px; font-size: 14px; }
  }
  @media (max-width: 400px) {
    .caballo__mega { font-size: clamp(56px, 28vw, 130px); }
    .caballo__phrase { font-size: 17px; }
  }
</style>
