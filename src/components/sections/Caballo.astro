---
import { type Lang, useTranslations } from "@/i18n/ui";
import { cldVideo, cldVideoPoster } from "@/lib/cloudinary";
import { CLD_IDS } from "@/lib/cloudinaryAssets";

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);

/**
 * Caballo · franja editorial de video + CABALLO limpio.
 *
 * Estructura editorial tipo magazine spread:
 *
 *   1. Una FRANJA cinemascope (21:9) arriba con el video del galope.
 *      Bordeada por reglas oro 1px — la firma del "moment editorial".
 *   2. Un caption italic chico debajo de la franja, tipo pie de foto
 *      de revista: "Galope libre · Pampa argentina".
 *   3. La palabra CABALLO grande en ink sobre paper, sin video adentro
 *      (el video vive en su propia zona, no compite).
 *   4. Eyebrow + phrase + keywords + closer debajo.
 *
 * Por qué este movimiento es más premium que la versión video-en-letras:
 *
 *   - Cada elemento tiene SU ZONA. No hay overlap visual, no hay
 *     legibilidad pelea contra fondo dinámico. Las decisiones
 *     editoriales son explícitas, no rescatadas.
 *   - El ratio cinemascope (21:9) lee como "momento de cine" — más
 *     próximo a una placa Hermès o Loro Piana que a un hero genérico.
 *   - Las reglas oro de 1px arriba y abajo de la franja firman el
 *     gesto editorial. Es el detalle que separa "video en una página"
 *     de "video en una pieza editorial".
 *   - Caption italic en oro: marker de pie de foto. Hermès, Vogue,
 *     Loewe — todos lo usan. Pequeño, lo lee solo quien presta atención;
 *     ese tipo de detalle es lujo silencioso.
 */

// Pedimos el video a 3000px de ancho para que en displays retina (DPR 2
// sobre desktops 1500-1920) el browser tenga píxeles extra para escalar
// sin pixelado visible. Cloudinary devuelve el source si tiene menos
// resolución, así que pedir alto es safe — no upscalea.
const horseVideoSrc = cldVideo(CLD_IDS.VID_HORSE_GALOPE, 3000);
const horseVideoPoster = cldVideoPoster(CLD_IDS.VID_HORSE_GALOPE, 2400);

const keywords = ["caballo.word_1", "caballo.word_2", "caballo.word_3", "caballo.word_4"] as const;
const megaWord = lang === "es" ? "Caballo" : "Horse";
const ariaTitle = `${t("caballo.eyebrow")} · ${t("caballo.title_1")} ${t("caballo.title_2")}`;
const filmCaption = lang === "es"
  ? "Galope libre · Pampa argentina"
  : "Free gallop · Argentine pampa";
---

<section
  class="caballo"
  id="caballo"
  aria-label={ariaTitle}
>
  <div class="caballo__container">
    <div class="caballo__editorial">
      <span class="caballo__eyebrow" data-cab-rev>{t("caballo.eyebrow")}</span>

      <!-- Video zone · UN solo video continuo que ocupa la franja
           superior (visible completa) + el área del CABALLO (visible
           solo por las letras). El paper del bottom zone se hace cargo
           del cierre natural — sin fade artificial. El top tiene un
           gradient mask suave que disuelve el inicio del video con el
           paper canvas de arriba (donde está el eyebrow). -->
      <div class="caballo__video-zone" data-cab-rev aria-label={ariaTitle}>
        <video
          class="caballo__zone-video"
          autoplay
          muted
          loop
          playsinline
          preload="auto"
          poster={horseVideoPoster}
          aria-hidden="true"
        >
          <source src={horseVideoSrc} type="video/mp4" />
        </video>
        <svg
          class="caballo__zone-mask"
          viewBox="0 0 1500 540"
          preserveAspectRatio="xMidYMid slice"
          aria-hidden="true"
        >
          <defs>
            <mask id="caballo-zone-mask">
              <!-- Top zone (y 0-200) en NEGRO: paper invisible, video full. -->
              <rect x="0" y="0" width="1500" height="200" fill="black" />
              <!-- Bottom zone (y 200-540) en BLANCO: paper visible.
                   Más corto que antes (340 en vez de 400) — menos paper
                   vacío abajo, el CABALLO se acerca al video. -->
              <rect x="0" y="200" width="1500" height="340" fill="white" />
              <!-- CABALLO knockout · y bajado de 500 a 440 para que las
                   letras casi toquen la franja arriba (gap de ~50 units
                   en lugar de ~90). El bloque se siente más denso. -->
              <text
                class="caballo__zone-text"
                x="750"
                y="440"
                text-anchor="middle"
                fill="black"
              >{megaWord.toUpperCase()}</text>
            </mask>
          </defs>
          <rect width="1500" height="540" fill="#fbf8f2" mask="url(#caballo-zone-mask)" />
        </svg>
        <h2 class="caballo__sr-title">{ariaTitle}</h2>
      </div>

      <p class="caballo__phrase" data-cab-rev>
        <span>{t("caballo.title_1")}</span>
        <em>{t("caballo.title_2")}</em>
      </p>

      <ul class="caballo__keywords" aria-hidden="true" data-cab-rev>
        {keywords.map((k, i) => (
          <li style={`--i:${i}`}>{t(k as any)}</li>
        ))}
      </ul>

      <p class="caballo__closer" data-cab-rev>{t("caballo.closer")}</p>
    </div>
  </div>
</section>

<script>
  import { onPageReady } from "@/lib/onPageReady";

  function wireCaballo(): void {
    const section = document.querySelector<HTMLElement>(".caballo");
    if (!section) return;

    // Reduced-motion · pausa el video (uno solo ahora, el del zone)
    // y deja el poster como still.
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      const vid = section.querySelector<HTMLVideoElement>(".caballo__zone-video");
      if (vid) {
        vid.removeAttribute("autoplay");
        vid.pause();
      }
    } else {
      // Smooth loop · enmascara el corte abrupto del loop del MP4.
      // El video `<video loop>` salta de duration a 0 instantáneamente,
      // produciendo un visible "salto" cuando el último frame no matchea
      // el primero. Sin tocar el archivo, el truco editorial es bajar
      // sutilmente la opacidad del video en los últimos 0.25s antes
      // del seam y mantenerla baja durante los primeros 0.25s del
      // restart — el corte queda en el momento de menor visibilidad,
      // leyendo como una "respiración" lenta en lugar de un jump cut.
      //
      // El threshold (0.25s) y la depth (opacity 0.7) son sweet spot:
      // suficiente para mascar el corte sin que el dim se perciba
      // como una pausa intencional. transition 0.35s con ease editorial
      // suaviza la entrada y salida del fade.
      const vid = section.querySelector<HTMLVideoElement>(".caballo__zone-video");
      if (vid) {
        const SEAM_WINDOW = 0.25;
        const updateLoopState = (): void => {
          if (!vid.duration || isNaN(vid.duration)) return;
          const timeLeft = vid.duration - vid.currentTime;
          const inSeam =
            timeLeft < SEAM_WINDOW || vid.currentTime < SEAM_WINDOW;
          vid.classList.toggle("is-looping", inSeam);
        };
        vid.addEventListener("timeupdate", updateLoopState);
      }
    }

    const targets = section.querySelectorAll<HTMLElement>(
      "[data-cab-rev]:not(.is-revealed)"
    );
    if (targets.length === 0) return;

    const allTargets = section.querySelectorAll<HTMLElement>("[data-cab-rev]");
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            const idx = Array.from(allTargets).indexOf(e.target as HTMLElement);
            const delay = `${idx * 0.14}s`;
            (e.target as HTMLElement).style.transitionDelay = delay;
            (e.target as HTMLElement).style.animationDelay = delay;
            e.target.classList.add("is-revealed");
            io.unobserve(e.target);
          }
        });
      },
      { threshold: 0.15 }
    );
    targets.forEach((el) => io.observe(el));

    document.addEventListener(
      "astro:before-swap",
      () => io.disconnect(),
      { once: true }
    );
  }
  onPageReady(wireCaballo);
</script>

<style>
  /* ============================================================
   * Caballo · franja editorial 21:9 + lockup CABALLO sobre paper
   * ============================================================ */
  .caballo {
    position: relative;
    width: 100%;
    background: var(--color-paper);
    padding: 140px 0 120px;
    overflow: hidden;
  }

  .caballo__container {
    max-width: 1500px;
    margin: 0 auto;
    padding: 0 5vw;
  }

  /* ---- Bloque editorial · texto sobre paper, centrado, con air ---- */
  .caballo__editorial {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-top: 32px;
  }

  /* ---- Video zone · franja video arriba + CABALLO knockout abajo.
   *
   * Structure híbrida: UN solo <video> playing detrás + SVG mask encima
   * que define dos zonas por height (top 35% = franja con video visible,
   * bottom 65% = paper con CABALLO knockout). El video se asoma por la
   * franja Y por las letras al mismo tiempo.
   *
   * Gradient mask SOLO en el borde superior (top fade) para que el inicio
   * del video se diluya orgánicamente con el paper-canvas donde está el
   * eyebrow. El borde inferior NO tiene fade — el paper del bottom zone
   * con CABALLO knockout cierra naturalmente la sección con borde nítido,
   * sin pixelado raro.
   *
   * Aspect 1500/720 (2.08:1) — más alto que el wide-only, suficiente
   * para que el CABALLO knockout abajo tenga presencia tipográfica. */
  .caballo__video-zone {
    position: relative;
    width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    aspect-ratio: 1500 / 540;
    margin-top: 48px;
    margin-bottom: 0;
    overflow: hidden;
    isolation: isolate;
    /* Background paper + buffer de 2px paper-colored al bottom · combate
     * el hairline residual que aparece en algunos browsers en el borde
     * inferior del SVG (subpixel anti-aliasing del paper rect contra
     * el video transformado con scale 1.2). El border-bottom extiende
     * 2px de paper sólido fuera del overflow, tapando cualquier pixel
     * de video que se asome por el edge. */
    background: var(--color-paper);
    border-bottom: 2px solid var(--color-paper);
    transform-origin: center;
    will-change: transform, opacity;
  }
  /* Sin entrance animation — el video aparece tal cual, sin scaleY
   * opening. El "se abre" leía como sci-fi cheap y el usuario lo
   * descartó. */
  .caballo__zone-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    z-index: 1;
    /* Scale 1.0 · el video nuevo de Flow (Horses_galloping_across_pampa)
     * no tiene letterbox bars horneadas como el anterior. El zoom del 1.2
     * estaba dejando el render efectivo al 83% de la resolución source,
     * leyéndose como pixelado. Sin scale, el video se ve a su nitidez
     * nativa. Si en algún viewport aparece una banda negra, subimos
     * progresivamente a 1.05 / 1.10 / 1.15. */
    transform: scale(1);
    /* Transition para el smooth-loop · suaviza la entrada y salida del
     * dim que enmascara el corte abrupto del loop. JS toggle .is-looping
     * en los últimos 0.25s antes del seam + primeros 0.25s del restart. */
    transition: opacity 0.35s var(--ease-editorial);
  }
  /* Estado de seam · dim editorial sutil. Opacity 0.7 = baja lo
   * suficiente para que el corte abrupto pase desapercibido, sin que
   * el dim mismo se perciba como una intención. El usuario lee el
   * conjunto como "el video respira lento", no como "el video se cortó". */
  .caballo__zone-video.is-looping {
    opacity: 0.7;
  }

  /* SVG mask · paper rect encima del video con dos zonas por height.
   * z-2 encima del video (z-1). Las cutouts del mask son: top zone
   * completa (negro = paper invisible → video visible) y CABALLO text
   * (negro dentro del bottom zone blanco → letras transparentes →
   * video visible por las letras). */
  .caballo__zone-mask {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 2;
    display: block;
  }

  /* Texto del CABALLO dentro del mask · Fraunces, weight 400 (fino,
   * editorial). Font-size 260 vs los 340 previos — más cercano al
   * sizing original del lockup que tenía la sección con la foto
   * adentro (clamp 22vw, max 340). letter-spacing -8 proporcional. */
  .caballo__zone-text {
    font-family: var(--font-display);
    font-size: 260px;
    font-weight: 400;
    letter-spacing: -8px;
  }
  /* ---- Eyebrow · gold uppercase ---- */
  .caballo__eyebrow {
    font-family: var(--font-sans);
    font-size: 11px;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: var(--color-cognac);
    margin-bottom: 32px;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 1s var(--ease-editorial), transform 1s var(--ease-editorial);
  }
  .caballo__eyebrow.is-revealed { opacity: 1; transform: translateY(0); }


  /* SR-only · h2 para screen-readers y SEO. */
  .caballo__sr-title {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    border: 0;
    clip: rect(0 0 0 0);
    overflow: hidden;
    white-space: nowrap;
  }

  /* ---- Phrase ---- · pegada al video-zone (gap mínimo de 8px para
   * que el conjunto franja + CABALLO + frase se lea como UN bloque
   * editorial denso, no como elementos sueltos). */
  .caballo__phrase {
    margin: 8px 0 0;
    font-family: var(--font-display);
    font-size: clamp(20px, 2vw, 30px);
    line-height: 1.3;
    letter-spacing: 0.005em;
    color: var(--color-ink);
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 1s var(--ease-editorial), transform 1s var(--ease-editorial);
  }
  .caballo__phrase.is-revealed { opacity: 1; transform: translateY(0); }
  .caballo__phrase em {
    font-family: var(--font-italic);
    font-style: italic;
    font-weight: 300;
    color: var(--color-cognac);
  }

  /* ---- Keywords ---- */
  .caballo__keywords {
    margin: 40px 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 18px 32px;
    font-family: var(--font-sans);
    font-size: 11px;
    letter-spacing: 0.42em;
    text-transform: uppercase;
    color: var(--color-stone);
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 1.1s var(--ease-editorial), transform 1.1s var(--ease-editorial);
  }
  .caballo__keywords.is-revealed { opacity: 1; transform: translateY(0); }
  .caballo__keywords li {
    position: relative;
    transition: color 0.4s, transform 0.4s var(--ease-soft);
  }
  .caballo__keywords li::before {
    content: "—";
    margin-right: 12px;
    color: var(--color-gold);
  }
  .caballo__keywords li:hover {
    color: var(--color-ink);
    transform: translateY(-2px);
  }

  /* ---- Closer ---- */
  .caballo__closer {
    margin: 36px 0 0;
    font-family: var(--font-italic);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(15px, 1.2vw, 18px);
    line-height: 1.5;
    color: rgba(21, 17, 13, 0.6);
    max-width: 480px;
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 1s var(--ease-editorial), transform 1s var(--ease-editorial);
  }
  .caballo__closer.is-revealed { opacity: 1; transform: translateY(0); }

  /* ---- Reduced motion ---- */
  @media (prefers-reduced-motion: reduce) {
    .caballo__eyebrow,
    .caballo__video-zone,
    .caballo__phrase,
    .caballo__keywords,
    .caballo__closer {
      opacity: 1 !important;
      transform: none !important;
      clip-path: inset(0 0 0 0) !important;
      -webkit-clip-path: inset(0 0 0 0) !important;
      transition: none !important;
      animation: none !important;
    }
    .caballo__zone-video {
      transform: none !important;
    }
  }

  /* ---- Mobile ---- */
  @media (max-width: 800px) {
    .caballo { padding: 96px 0 80px; }
    /* Video zone en mobile · 5:4 (más cuadrado) para que el CABALLO
     * knockout se vea legible en pantalla angosta. */
    .caballo__video-zone {
      aspect-ratio: 5 / 4;
    }
    .caballo__zone-text { font-size: 200px; }
    .caballo__keywords {
      gap: 12px 20px;
      font-size: 10px;
      letter-spacing: 0.32em;
    }
    .caballo__keywords li::before { margin-right: 8px; }
    .caballo__closer { margin-top: 28px; font-size: 14px; }
  }
  @media (max-width: 400px) {
    .caballo__video-zone { aspect-ratio: 4 / 3; }
    .caballo__phrase { font-size: 17px; }
  }
</style>
