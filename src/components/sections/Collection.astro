---
import { getCollection } from "astro:content";
import { type Lang, useTranslations } from "@/i18n/ui";
import Reveal from "@/components/shared/Reveal.astro";
import { cldImage } from "@/lib/cloudinary";
import { CLD_IDS, type CldKey } from "@/lib/cloudinaryAssets";

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);

const products = (await getCollection("products")).sort(
  (a, b) => a.data.order - b.data.order
);
---

<section class="collection" id="coleccion">
  <div class="section__head">
    <Reveal class="eyebrow">{t("collection.eyebrow")}</Reveal>
    <h2 class="collection__title" data-coll-title>
      <span class="line">{t("collection.title_1")} <em>{t("collection.title_2")}</em></span>
    </h2>
    <p class="collection__sub" data-coll-sub>{t("collection.sub")}</p>
  </div>

  <div class="collection__grid">
    {products.map((product, i) => (
      <article
        class="card"
        data-card
        style={`--card-delay: ${i * 90}ms`}
      >
        <span class="card__num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
        <div class="card__media">
          <div class="card__media-inner">
            <img
              src={cldImage(CLD_IDS[product.data.image as CldKey], 1000)}
              alt={product.data.alt}
              loading="lazy"
              decoding="async"
            />
          </div>
        </div>
        <div class="card__body">
          <h3 class="card__name">{product.data.name[lang]}</h3>
        </div>
      </article>
    ))}
  </div>
</section>

<script>
  import { onPageReady } from "@/lib/onPageReady";

  function wireCollection(): void {
    // ---- IntersectionObserver-driven reveals ----
    const reveal = (el: Element): void => el.classList.add("is-revealed");

    const cards = document.querySelectorAll<HTMLElement>("[data-card]");
    const title = document.querySelector<HTMLElement>("[data-coll-title]");
    const sub = document.querySelector<HTMLElement>("[data-coll-sub]");

    const ioCard = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            reveal(e.target);
            ioCard.unobserve(e.target);
          }
        });
      },
      { threshold: 0.16, rootMargin: "0px 0px -60px 0px" }
    );
    cards.forEach((c) => ioCard.observe(c));

    const ioTitle = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            reveal(e.target);
            ioTitle.unobserve(e.target);
          }
        });
      },
      { threshold: 0.5 }
    );
    if (title) ioTitle.observe(title);
    if (sub) ioTitle.observe(sub);

    // ---- Mouse-follow micro-parallax on hover (desktop only) ----
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const noHover = window.matchMedia("(hover: none)").matches;
    if (reduced || noHover) return;

    cards.forEach((card) => {
      const inner = card.querySelector<HTMLElement>(".card__media-inner");
      if (!inner) return;
      let raf: number | null = null;
      let tx = 0, ty = 0, mx = 0, my = 0;
      let active = false;

      const tick = (): void => {
        mx += (tx - mx) * 0.12;
        my += (ty - my) * 0.12;
        const baseScale = active ? 1.04 : 1;
        inner.style.transform = `translate3d(${mx.toFixed(2)}px, ${my.toFixed(2)}px, 0) scale(${baseScale})`;
        if (Math.abs(tx - mx) > 0.1 || Math.abs(ty - my) > 0.1) {
          raf = requestAnimationFrame(tick);
        } else {
          raf = null;
        }
      };

      card.addEventListener("pointerenter", () => { active = true; });
      card.addEventListener("pointermove", (e) => {
        const r = card.getBoundingClientRect();
        const px = (e.clientX - r.left) / r.width - 0.5;
        const py = (e.clientY - r.top) / r.height - 0.5;
        tx = px * 12;
        ty = py * 8;
        if (raf === null) raf = requestAnimationFrame(tick);
      });
      card.addEventListener("pointerleave", () => {
        active = false;
        tx = 0; ty = 0;
        if (raf === null) raf = requestAnimationFrame(tick);
      });
    });
  }
  onPageReady(wireCollection);
</script>

<style>
  .collection { background: var(--color-ivory); padding-bottom: 160px; }

  /* ---------- Section head ---------- */
  .collection__title {
    font-family: var(--font-display);
    font-size: clamp(36px, 4.5vw, 72px);
    line-height: 1.05;
    font-weight: 400;
    margin-top: 22px;
  }
  .collection__title .line {
    display: inline-block;
    /* generous padding so descenders / italic glyphs don't get clipped */
    padding: 0.12em 0.06em;
    margin: -0.12em -0.06em;
    clip-path: inset(100% 0 0 0);
    -webkit-clip-path: inset(100% 0 0 0);
    filter: blur(6px);
    transform: translateY(8px);
    will-change: clip-path, filter, transform;
  }
  .collection__title.is-revealed .line {
    animation: collTitleRise 1.5s var(--ease-editorial) forwards;
  }
  @keyframes collTitleRise {
    0% {
      clip-path: inset(100% 0 0 0);
      -webkit-clip-path: inset(100% 0 0 0);
      filter: blur(6px);
      transform: translateY(8px);
    }
    60% { filter: blur(2px); }
    100% {
      clip-path: inset(0 0 0 0);
      -webkit-clip-path: inset(0 0 0 0);
      filter: blur(0);
      transform: translateY(0);
    }
  }
  .collection__title em {
    font-family: var(--font-italic);
    font-style: italic;
    font-weight: 300;
    color: var(--color-cognac);
  }

  .collection__sub {
    margin-top: 26px;
    max-width: 540px;
    color: rgba(21, 17, 13, 0.65);
    font-size: 16px;
    line-height: 1.6;
    opacity: 0;
    transform: translateY(14px);
    transition: opacity 1s var(--ease-editorial) 0.35s,
      transform 1s var(--ease-editorial) 0.35s;
  }
  .collection__sub.is-revealed {
    opacity: 1;
    transform: translateY(0);
  }

  /* ---------- Grid ---------- */
  .collection__grid {
    max-width: 1500px;
    margin: 0 auto;
    padding: 60px 5vw 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px 28px;
  }

  /* ---------- Card ---------- */
  .card {
    position: relative;
    display: block;
  }

  .card__num {
    position: absolute;
    top: -22px;
    left: 0;
    font-family: var(--font-sans);
    font-size: 10.5px;
    letter-spacing: 0.36em;
    text-transform: uppercase;
    color: var(--color-stone);
    z-index: 2;
    opacity: 0;
    transform: translateX(-8px);
    transition: opacity 0.7s var(--ease-editorial),
      transform 0.7s var(--ease-editorial),
      color 0.4s;
    transition-delay: calc(var(--card-delay, 0ms) + 0.7s);
  }
  .card.is-revealed .card__num {
    opacity: 1;
    transform: translateX(0);
  }
  .card:hover .card__num { color: var(--color-cognac); }

  /* Image wrapper handles the mask reveal; inner handles transform (parallax/scale) */
  .card__media {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    margin-bottom: 22px;
    background: var(--color-bone);
    clip-path: inset(0 0 100% 0);
    -webkit-clip-path: inset(0 0 100% 0);
    filter: blur(6px) saturate(0.92);
    will-change: clip-path, filter;
  }
  .card.is-revealed .card__media {
    animation: cardImageRise 1.4s var(--ease-editorial) forwards;
    animation-delay: var(--card-delay, 0ms);
  }
  @keyframes cardImageRise {
    0% {
      clip-path: inset(0 0 100% 0);
      -webkit-clip-path: inset(0 0 100% 0);
      filter: blur(6px) saturate(0.92);
    }
    60% { filter: blur(1.5px) saturate(0.97); }
    100% {
      clip-path: inset(0 0 0 0);
      -webkit-clip-path: inset(0 0 0 0);
      filter: blur(0) saturate(1);
    }
  }

  .card__media-inner {
    width: 100%;
    height: 100%;
    will-change: transform;
    transition: transform 0.6s var(--ease-soft);
  }
  .card__media-inner :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: filter 0.6s;
    filter: saturate(0.94);
  }
  .card:hover .card__media-inner :global(img) { filter: saturate(1.02); }

  /* ---------- Body — staggered reveal ---------- */
  .card__name {
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.85s var(--ease-editorial),
      transform 0.85s var(--ease-editorial);
  }
  .card.is-revealed .card__name {
    opacity: 1;
    transform: translateY(0);
    transition-delay: calc(var(--card-delay, 0ms) + 0.55s);
  }

  .card__name {
    font-size: 26px;
    line-height: 1.2;
    font-weight: 400;
    margin-bottom: 8px;
  }

  /* ---------- Reduced motion ---------- */
  @media (prefers-reduced-motion: reduce) {
    .collection__title .line,
    .card__media,
    .card__name,
    .card__num,
    .collection__sub {
      clip-path: none;
      -webkit-clip-path: none;
      filter: none;
      transform: none;
      opacity: 1;
      animation: none;
    }
  }

  @media (max-width: 1100px) {
    .collection__grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 700px) {
    .collection__grid { grid-template-columns: 1fr; gap: 56px 0; padding-top: 40px; }
  }
  @media (max-width: 500px) {
    /* Numbers floated above each card need more breathing room when 1-col */
    .card__num { top: -18px; font-size: 10px; letter-spacing: 0.32em; }
    .card__name { font-size: 22px; }
    .card__media { margin-bottom: 18px; }
  }
</style>
