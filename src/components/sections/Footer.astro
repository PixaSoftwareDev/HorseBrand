---
import { type Lang, useTranslations } from "@/i18n/ui";
import {
  INSTAGRAM_URL,
  INSTAGRAM_HANDLE,
  TERMS_URL,
} from "@/lib/contact";
import { SHOP_BASE_URL } from "@/lib/shop";

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="footer">
  <!--
    Closing moment — "lujo silencioso" como ancla del cierre.
    Sin reglas doradas ni bordes apilados; el silencio (whitespace) hace
    de separador entre el wordmark, el motto y la fila utility. Una sola
    hairline al pie marca el límite legal. Bracketea el opening del
    Hero (donde "Horse Brand" aparece dentro del diptych close) con un
    eco silencioso al final del scroll: misma marca, mismo gesto.
  -->
  <div class="footer__closing" data-footer-closing>
    <img
      class="footer__wordmark"
      src="https://res.cloudinary.com/dukv3ov6t/image/upload/v1778936974/HB_main_positivo_uohobt.svg"
      alt="Horse Brand"
      loading="lazy"
      decoding="async"
    />

    <p class="footer__motto">
      {t("footer.closing_motto")} <em>{t("footer.closing_motto_italic")}</em>
    </p>

    <span class="footer__origin">{t("footer.closing_origin")}</span>
  </div>

  <div class="footer__bottom">
    <nav class="footer__links" aria-label={t("footer.links_label")}>
      <a href={SHOP_BASE_URL} target="_blank" rel="noopener">
        {t("footer.visit_shop")}
      </a>
      <a
        class="footer__ig"
        href={INSTAGRAM_URL}
        target="_blank"
        rel="noopener"
        aria-label={`Instagram ${INSTAGRAM_HANDLE}`}
      >
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.4"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <rect x="3" y="3" width="18" height="18" rx="5" />
          <circle cx="12" cy="12" r="4" />
          <circle cx="17.5" cy="6.5" r="0.9" fill="currentColor" stroke="none" />
        </svg>
        <span>Instagram</span>
      </a>
      {TERMS_URL && (
        <a href={TERMS_URL} target="_blank" rel="noopener">
          {t("footer.policy_terms")}
        </a>
      )}
    </nav>

    <span class="footer__copy">© {year} · Horse Brand</span>
  </div>
</footer>

<style>
  /* Footer integrado con Contact — mismo fondo (--color-paper) para que
   * se lea como continuación natural del panel de contacto, no como
   * otra pantalla. Padding y wordmark dimensionados para ocupar ~30vh,
   * no toda la viewport. */
  .footer {
    background: var(--color-paper);
    color: rgba(21, 17, 13, 0.7);
    padding: 0 5vw;
    display: flex;
    flex-direction: column;
  }

  /* ---------- CIERRE · lujo silencioso ----------
   * Compacto: el wordmark firma el sitio sin reclamar otra pantalla.
   * Whitespace ajustado, no derrochado.
   */
  .footer__closing {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 16px;
    /* Top reducido 60 → 40 · gap con Contact más ajustado, editorial. */
    padding: 40px 5vw 50px;
    max-width: 1500px;
    margin: 0 auto;
    width: 100%;
  }

  /* Logo SVG · firma editorial, no titular.
   * Más chico que antes (era clamp 260→520) para que respire dentro
   * del cierre integrado con Contact. */
  .footer__wordmark {
    display: block;
    width: clamp(180px, 22vw, 340px);
    height: auto;
    opacity: 0;
    transform: translateY(14px);
    filter: blur(4px);
    transition: opacity 1.2s var(--ease-editorial),
      transform 1.2s var(--ease-editorial),
      filter 1.2s var(--ease-editorial);
  }
  .footer__closing.is-visible .footer__wordmark {
    opacity: 1;
    transform: translateY(0);
    filter: blur(0);
  }

  .footer__motto {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 11px;
    letter-spacing: 0.34em;
    text-transform: uppercase;
    color: var(--color-stone);
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 1s var(--ease-editorial) 0.4s,
      transform 1s var(--ease-editorial) 0.4s;
  }
  .footer__motto em {
    font-family: var(--font-italic);
    font-style: italic;
    font-weight: 300;
    font-size: 15px;
    text-transform: none;
    letter-spacing: 0.005em;
    color: var(--color-cognac);
    margin-left: 8px;
  }
  .footer__closing.is-visible .footer__motto {
    opacity: 1;
    transform: translateY(0);
  }

  .footer__origin {
    font-family: var(--font-sans);
    font-size: 9.5px;
    letter-spacing: 0.46em;
    text-transform: uppercase;
    color: rgba(21, 17, 13, 0.4);
    opacity: 0;
    transition: opacity 1s var(--ease-editorial) 0.7s;
  }
  .footer__closing.is-visible .footer__origin {
    opacity: 1;
  }

  /* ---------- Fila utility · separada por una ÚNICA hairline ----------
   * Tipografía chica, baja-contraste. Links a la izquierda, copyright
   * a la derecha. En mobile colapsa en columna centrada.
   */
  .footer__bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 18px 0 22px;
    border-top: 1px solid rgba(21, 17, 13, 0.08);
    max-width: 1500px;
    margin: 0 auto;
    width: 100%;
  }

  .footer__links {
    display: flex;
    align-items: center;
    gap: 28px;
  }
  .footer__links a {
    font-family: var(--font-sans);
    font-size: 10.5px;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--color-ink);
    padding-bottom: 2px;
    background-image: linear-gradient(currentColor, currentColor);
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 0% 1px;
    transition: background-size 0.5s var(--ease-editorial), color 0.4s;
  }
  .footer__links a:hover {
    color: var(--color-cognac);
    background-size: 100% 1px;
  }

  /* Instagram link · icono inline + label, alineados verticalmente.
   * El underline-on-hover sigue funcionando sobre todo el link gracias
   * a la línea de gradient que vive en el <a>. */
  .footer__ig {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .footer__ig svg {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    /* el icono se alinea óptimamente con el baseline del texto uppercase */
    transform: translateY(-0.5px);
  }

  .footer__copy {
    font-family: var(--font-sans);
    font-size: 10px;
    letter-spacing: 0.36em;
    text-transform: uppercase;
    color: rgba(21, 17, 13, 0.45);
  }

  @media (prefers-reduced-motion: reduce) {
    .footer__wordmark,
    .footer__motto,
    .footer__origin {
      opacity: 1 !important;
      transform: none !important;
      filter: none !important;
      transition: none !important;
    }
    .footer__origin { opacity: 1 !important; }
  }

  @media (max-width: 900px) {
    .footer__closing {
      padding: 50px 6vw 40px;
      gap: 14px;
    }
    .footer__wordmark { width: clamp(160px, 32vw, 240px); }
    .footer__motto { font-size: 10.5px; letter-spacing: 0.28em; }
    .footer__motto em { font-size: 14px; margin-left: 8px; }
    .footer__origin { font-size: 9px; letter-spacing: 0.38em; }

    .footer__bottom {
      flex-direction: column;
      gap: 14px;
      text-align: center;
      padding: 18px 0 22px;
    }
  }

  @media (max-width: 500px) {
    .footer__closing {
      padding: 44px 7vw 36px;
      gap: 14px;
    }
    .footer__wordmark { width: clamp(150px, 42vw, 220px); }
    .footer__motto em { display: block; margin: 6px 0 0; }
    .footer__links {
      flex-wrap: wrap;
      justify-content: center;
      gap: 20px;
    }
    .footer__links a { font-size: 10px; letter-spacing: 0.26em; }
    .footer__copy { font-size: 9px; letter-spacing: 0.28em; }
  }
</style>

<script>
  import { onPageReady } from "@/lib/onPageReady";

  /*
   * Closing reveal — staggered fade-in cuando el bloque entra en viewport.
   * One-shot (unobserve después del primer trigger) para que no re-anime
   * al scrollear de vuelta.
   */
  function wireFooterClosing(): void {
    const block = document.querySelector<HTMLElement>("[data-footer-closing]");
    if (!block || block.dataset.wired === "1") return;
    block.dataset.wired = "1";

    if (!("IntersectionObserver" in window)) {
      block.classList.add("is-visible");
      return;
    }

    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            io.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.3 }
    );
    io.observe(block);

    document.addEventListener("astro:before-swap", () => io.disconnect(), {
      once: true,
    });
  }

  onPageReady(wireFooterClosing);
</script>
