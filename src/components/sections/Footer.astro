---
import { Image } from "astro:assets";
import { type Lang, useTranslations } from "@/i18n/ui";
import logoMain from "@/assets/logo/logo-main.png";
import {
  INSTAGRAM_URL,
  INSTAGRAM_HANDLE,
  TERMS_URL,
} from "@/lib/contact";
import { SHOP_BASE_URL } from "@/lib/shop";

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer__row">
    <div class="footer__brand">
      <Image src={logoMain} alt="Horse Brand" widths={[160, 320]} sizes="160px" />
      <span class="footer__tag">{t("footer.tag")}</span>
    </div>

    <a
      class="footer__shop"
      href={SHOP_BASE_URL}
      target="_blank"
      rel="noopener"
      aria-label={t("footer.visit_shop")}
    >
      <span>{t("footer.visit_shop")}</span>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true">
        <path d="M5 12h14M13 5l7 7-7 7"/>
      </svg>
    </a>

    <nav class="footer__links" aria-label={t("footer.links_label")}>
      {TERMS_URL && (
        <a href={TERMS_URL} target="_blank" rel="noopener">{t("footer.policy_terms")}</a>
      )}
      <a href={INSTAGRAM_URL} target="_blank" rel="noopener" aria-label={`Instagram ${INSTAGRAM_HANDLE}`}>
        Instagram
      </a>
    </nav>
  </div>

  <div class="footer__meta">
    <span>© {year}</span>
    <span class="footer__sep" aria-hidden="true">·</span>
    <span>Buenos Aires</span>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-bone);
    color: rgba(21, 17, 13, 0.7);
    padding: 28px 5vw 24px;
    border-top: 1px solid rgba(21, 17, 13, 0.06);
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  /* ---- Top row · 3 zones (brand · shop · links) ---- */
  .footer__row {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 32px;
    max-width: 1500px;
    margin: 0 auto;
    width: 100%;
  }

  /* ---- Brand · left ---- */
  .footer__brand {
    display: flex;
    align-items: center;
    gap: 16px;
    justify-self: start;
  }
  .footer__brand :global(img) {
    height: 64px;
    width: auto;
    opacity: 0.95;
  }
  .footer__tag {
    font-family: var(--font-sans);
    font-size: 12px;
    letter-spacing: 0.36em;
    text-transform: uppercase;
    color: var(--color-stone);
  }

  /* ---- Shop CTA · center · ghost button with arrow ---- */
  .footer__shop {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    padding: 12px 26px;
    border: 1px solid rgba(21, 17, 13, 0.32);
    font-family: var(--font-sans);
    font-size: 11px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--color-ink);
    background: transparent;
    justify-self: center;
    transition: background 0.45s var(--ease-editorial),
      color 0.45s var(--ease-editorial),
      border-color 0.45s var(--ease-editorial),
      gap 0.45s var(--ease-editorial),
      transform 0.45s var(--ease-soft);
  }
  .footer__shop svg {
    width: 14px;
    height: 14px;
    transition: transform 0.45s var(--ease-editorial);
  }
  .footer__shop:hover {
    background: var(--color-ink);
    color: #f7f3ec;
    border-color: var(--color-ink);
    gap: 20px;
    transform: translateY(-2px);
  }
  .footer__shop:hover svg { transform: translateX(4px); }

  /* ---- Links · right ---- */
  .footer__links {
    display: flex;
    align-items: center;
    gap: 28px;
    justify-self: end;
  }
  .footer__links a {
    position: relative;
    font-family: var(--font-sans);
    font-size: 11px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--color-ink);
    padding-bottom: 3px;
    background-image: linear-gradient(currentColor, currentColor);
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 0% 1px;
    transition: background-size 0.5s var(--ease-editorial), color 0.4s;
  }
  .footer__links a:hover {
    color: var(--color-cognac);
    background-size: 100% 1px;
  }

  /* ---- Meta · hairline divider above, centered ---- */
  .footer__meta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding-top: 14px;
    border-top: 1px solid rgba(21, 17, 13, 0.08);
    font-family: var(--font-sans);
    font-size: 10px;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: rgba(21, 17, 13, 0.45);
    max-width: 1500px;
    margin: 0 auto;
    width: 100%;
  }
  .footer__sep { color: rgba(21, 17, 13, 0.25); }

  /* ---- Tablet (≤900px) · collapse the 3-column row to stacked center ---- */
  @media (max-width: 900px) {
    .footer { padding: 40px 6vw 26px; gap: 22px; }
    .footer__row {
      grid-template-columns: 1fr;
      justify-items: center;
      gap: 22px;
      text-align: center;
    }
    .footer__brand,
    .footer__shop,
    .footer__links { justify-self: center; }
  }
  @media (max-width: 600px) {
    .footer__brand {
      flex-direction: column;
      gap: 10px;
    }
    .footer__brand :global(img) { height: 52px; }
    .footer__tag { font-size: 10px; letter-spacing: 0.28em; }
    .footer__links { gap: 22px; }
    .footer__links a { font-size: 10px; letter-spacing: 0.24em; }
    .footer__shop { padding: 11px 22px; font-size: 10px; letter-spacing: 0.24em; }
    .footer__meta { font-size: 9px; letter-spacing: 0.24em; gap: 8px; }
  }
</style>
