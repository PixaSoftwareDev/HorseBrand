---
import { type Lang, useTranslations } from "@/i18n/ui";
import Reveal from "@/components/shared/Reveal.astro";

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);

const cities = [
  { name: t("heritage.city_1"), year: t("heritage.city_1_year") },
  { name: t("heritage.city_2"), year: t("heritage.city_2_year") },
  { name: t("heritage.city_3"), year: t("heritage.city_3_year") },
  { name: t("heritage.city_4"), year: t("heritage.city_4_year") },
  { name: t("heritage.city_5"), year: t("heritage.city_5_year") },
  { name: t("heritage.city_6"), year: t("heritage.city_6_year") },
];
---

<section class="heritage" aria-label={t("heritage.eyebrow")}>
  <div class="heritage__inner">
    <div class="heritage__head">
      <Reveal class="heritage__eyebrow">{t("heritage.eyebrow")}</Reveal>
      <Reveal as="h2">
        <span>{t("heritage.title_1")}</span>
        <em>{t("heritage.title_2")}</em>
      </Reveal>
      <Reveal as="p" class="heritage__intro" delay={120}>{t("heritage.intro")}</Reveal>
    </div>

    <Reveal as="div" class="heritage__cities-wrap" delay={200}>
      <span class="heritage__cities-label">{t("heritage.cities_label")}</span>

      <ul class="heritage__cities" data-heritage-cities>
        {cities.map((c, i) => (
          <li class="heritage-city" style={`--i:${i}`}>
            <span class="heritage-city__year">{c.year}</span>
            <span class="heritage-city__name">{c.name}</span>
          </li>
        ))}
      </ul>
    </Reveal>

    <Reveal as="div" class="heritage__tagline" delay={300}>
      <p class="heritage__line-1">{t("heritage.tagline_1")}</p>
      <p class="heritage__line-2">{t("heritage.tagline_2")}</p>
    </Reveal>
  </div>
</section>

<style>
  .heritage {
    background: var(--color-ink);
    color: #f7f3ec;
    padding: 130px 5vw 120px;
    position: relative;
    overflow: hidden;
  }
  /* Subtle gold glow, kept from previous version */
  .heritage::before {
    content: "";
    position: absolute;
    left: -10%;
    bottom: -40%;
    width: 60%;
    height: 100%;
    background: radial-gradient(
      circle at 30% 70%,
      rgba(176, 133, 82, 0.18) 0%,
      transparent 60%
    );
    pointer-events: none;
  }

  .heritage__inner {
    max-width: 1300px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 72px;
  }

  /* ---- Head ---- */
  .heritage__head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 22px;
    max-width: 700px;
  }
  :global(.heritage__eyebrow) {
    font-family: var(--font-sans);
    font-size: 11px;
    letter-spacing: 0.42em;
    text-transform: uppercase;
    color: var(--color-gold);
    font-weight: 400;
  }
  .heritage__head h2 {
    color: #f7f3ec;
    font-size: clamp(36px, 4.4vw, 64px);
    line-height: 1.05;
    font-weight: 400;
    letter-spacing: 0;
  }
  .heritage__head h2 em {
    font-family: var(--font-italic);
    font-style: italic;
    font-weight: 300;
    color: var(--color-gold);
    display: block;
  }
  .heritage__intro {
    font-family: var(--font-italic);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(16px, 1.4vw, 20px);
    line-height: 1.55;
    color: rgba(247, 243, 236, 0.78);
    max-width: 580px;
  }

  /* ---- Cities · the real "presence" map ---- */
  :global(.heritage__cities-wrap) {
    width: 100%;
    max-width: 1100px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 30px;
  }
  .heritage__cities-label {
    font-family: var(--font-sans);
    font-size: 10px;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: rgba(247, 243, 236, 0.45);
  }

  .heritage__cities {
    list-style: none;
    margin: 0;
    padding: 0;
    width: 100%;
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 0;
    border-top: 1px solid rgba(247, 243, 236, 0.14);
    border-bottom: 1px solid rgba(247, 243, 236, 0.14);
  }
  .heritage-city {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    padding: 32px 14px;
    border-left: 1px solid rgba(247, 243, 236, 0.10);
    position: relative;
    transition: background 0.5s var(--ease-editorial);
    /* Stagger the city entrance with a small delay per index */
    opacity: 0;
    transform: translateY(10px);
    animation: cityRise 0.9s var(--ease-editorial) forwards;
    animation-delay: calc(var(--i) * 0.1s + 0.4s);
  }
  .heritage-city:first-child { border-left: 0; }
  .heritage-city:hover { background: rgba(247, 243, 236, 0.03); }
  /* Subtle pulsing dot above each city — like a place marker on a map */
  .heritage-city::before {
    content: "";
    position: absolute;
    top: -3px;
    left: 50%;
    transform: translateX(-50%);
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--color-gold);
    box-shadow: 0 0 0 3px rgba(176, 133, 82, 0.15);
    animation: cityPulse 3.2s ease-in-out infinite;
    animation-delay: calc(var(--i) * 0.4s);
  }
  @keyframes cityRise {
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes cityPulse {
    0%, 100% { box-shadow: 0 0 0 3px rgba(176, 133, 82, 0.15); }
    50% { box-shadow: 0 0 0 7px rgba(176, 133, 82, 0); }
  }

  .heritage-city__year {
    font-family: var(--font-sans);
    font-size: 10px;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--color-gold);
    font-weight: 400;
  }
  .heritage-city__name {
    font-family: var(--font-display);
    font-size: clamp(15px, 1.2vw, 19px);
    color: #f7f3ec;
    letter-spacing: 0.02em;
    line-height: 1.2;
  }

  /* ---- Tagline ---- */
  :global(.heritage__tagline) {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    margin-top: 6px;
  }
  .heritage__line-1 {
    font-family: var(--font-italic);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(18px, 1.6vw, 24px);
    color: var(--color-gold);
    letter-spacing: 0.005em;
  }
  .heritage__line-2 {
    font-family: var(--font-sans);
    font-size: 12px;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: rgba(247, 243, 236, 0.65);
  }

  /* ---- Responsive ---- */
  @media (max-width: 1024px) {
    .heritage__cities { grid-template-columns: repeat(3, 1fr); }
    .heritage-city:nth-child(4) { border-left: 0; }
    .heritage-city:nth-child(n+4) {
      border-top: 1px solid rgba(247, 243, 236, 0.10);
    }
  }
  @media (max-width: 600px) {
    .heritage { padding: 90px 5vw 90px; }
    .heritage__inner { gap: 50px; }
    .heritage__cities { grid-template-columns: repeat(2, 1fr); }
    .heritage-city:nth-child(odd) { border-left: 0; }
    .heritage-city:nth-child(n+3) {
      border-top: 1px solid rgba(247, 243, 236, 0.10);
    }
    .heritage-city { padding: 22px 10px; }
  }
  @media (max-width: 400px) {
    .heritage__head h2 { font-size: clamp(28px, 9vw, 40px); }
    .heritage-city__name { font-size: 14px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .heritage-city {
      opacity: 1;
      transform: none;
      animation: none;
    }
    .heritage-city::before {
      animation: none;
    }
  }
</style>
