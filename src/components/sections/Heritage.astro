---
import { type Lang, useTranslations } from "@/i18n/ui";
import Reveal from "@/components/shared/Reveal.astro";

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);

// Stats genéricos (no cronología, no capitales específicas).
const stats = [
  { value: t("heritage.stat_1_value"), label: t("heritage.stat_1_label") },
  { value: t("heritage.stat_2_value"), label: t("heritage.stat_2_label") },
  { value: t("heritage.stat_3_value"), label: t("heritage.stat_3_label") },
];
---

<section class="heritage" id="patrimonio" aria-label={t("heritage.eyebrow")}>
  <div class="heritage__inner">
    <div class="heritage__head">
      <Reveal as="h2">
        <span>{t("heritage.title_1")}</span>
        <em>{t("heritage.title_2")}</em>
      </Reveal>
      <Reveal as="p" class="heritage__intro" delay={120}>{t("heritage.intro")}</Reveal>
    </div>

    <Reveal as="div" class="heritage__stats-wrap" delay={200}>
      <span class="heritage__stats-label">{t("heritage.stats_label")}</span>

      <ul class="heritage__stats" data-heritage-stats>
        {stats.map((s, i) => (
          <li class="heritage-stat" style={`--i:${i}`}>
            <span class="heritage-stat__value">{s.value}</span>
            <span class="heritage-stat__label">{s.label}</span>
          </li>
        ))}
      </ul>
    </Reveal>
  </div>
</section>

<style>
  /* Heritage · editorial sobre paper canvas (matchea el resto del home).
   * Antes era dark ink con grilla de ciudades cronológicas — ahora es
   * un cierre editorial paper-light con tres stats genéricos (países,
   * continentes, años) sin nombres ni fechas específicas que puedan
   * envejecer. */
  .heritage {
    background: var(--color-paper);
    color: var(--color-ink);
    padding: 130px 5vw 120px;
    position: relative;
    overflow: hidden;
  }
  /* Glow gold sutil en una esquina · le da calor sin sacarlo del paper. */
  .heritage::before {
    content: "";
    position: absolute;
    left: -10%;
    bottom: -40%;
    width: 60%;
    height: 100%;
    background: radial-gradient(
      circle at 30% 70%,
      rgba(176, 133, 82, 0.08) 0%,
      transparent 60%
    );
    pointer-events: none;
  }

  .heritage__inner {
    max-width: 1300px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 72px;
  }

  /* ---- Head ---- */
  .heritage__head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 22px;
    max-width: 720px;
  }
  :global(.heritage__eyebrow) {
    font-family: var(--font-sans);
    font-size: 11px;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: var(--color-cognac);
    font-weight: 400;
  }
  .heritage__head :global(h2) {
    font-size: clamp(36px, 4.4vw, 60px);
    line-height: 1.05;
    font-weight: 400;
    letter-spacing: 0;
  }
  .heritage__head :global(h2) span {
    display: inline;
  }
  .heritage__head :global(h2) em {
    font-family: var(--font-italic);
    font-style: italic;
    font-weight: 400;
    display: block;
  }
  .heritage__intro {
    font-family: var(--font-italic);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(16px, 1.3vw, 19px);
    line-height: 1.6;
    color: rgba(21, 17, 13, 0.7);
    max-width: 620px;
  }

  /* ---- Stats · 3 números genéricos en row ---- */
  :global(.heritage__stats-wrap) {
    width: 100%;
    max-width: 900px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 28px;
  }
  .heritage__stats-label {
    font-family: var(--font-sans);
    font-size: 10px;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: var(--color-stone);
  }

  .heritage__stats {
    list-style: none;
    margin: 0;
    padding: 0;
    width: 100%;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid rgba(21, 17, 13, 0.12);
    border-bottom: 1px solid rgba(21, 17, 13, 0.12);
  }
  .heritage-stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    padding: 44px 16px;
    border-left: 1px solid rgba(21, 17, 13, 0.08);
    transition: background 0.5s var(--ease-editorial);
    opacity: 0;
    transform: translateY(10px);
    animation: heritageStatRise 0.9s var(--ease-editorial) forwards;
    animation-delay: calc(var(--i) * 0.12s + 0.4s);
  }
  .heritage-stat:first-child { border-left: 0; }
  .heritage-stat:hover { background: rgba(21, 17, 13, 0.02); }
  @keyframes heritageStatRise {
    to { opacity: 1; transform: translateY(0); }
  }

  .heritage-stat__value {
    font-family: var(--font-display);
    font-size: clamp(40px, 4.4vw, 64px);
    font-weight: 400;
    color: rgba(21, 17, 13, 0.78);
    line-height: 1;
    letter-spacing: -0.01em;
  }
  .heritage-stat__label {
    font-family: var(--font-sans);
    font-size: 10.5px;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--color-stone);
    font-weight: 400;
    max-width: 180px;
    line-height: 1.4;
  }

  /* ---- Responsive ---- */
  @media (max-width: 900px) {
    .heritage { padding: 100px 5vw 100px; }
    .heritage__inner { gap: 56px; }
    .heritage__stats { grid-template-columns: 1fr; }
    .heritage-stat {
      border-left: 0;
      border-top: 1px solid rgba(21, 17, 13, 0.08);
      padding: 32px 16px;
    }
    .heritage-stat:first-child { border-top: 0; }
  }
  @media (max-width: 500px) {
    .heritage { padding: 80px 5vw 84px; }
    .heritage__head :global(h2) { font-size: clamp(28px, 9vw, 40px); }
    .heritage-stat__value { font-size: clamp(36px, 12vw, 48px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .heritage-stat {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }
</style>
