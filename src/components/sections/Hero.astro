---
import { type Lang, useTranslations } from "@/i18n/ui";
import { localizedPath } from "@/i18n/utils";
import { cldImage } from "@/lib/cloudinary";
import { CLD_IDS } from "@/lib/cloudinaryAssets";

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const home = localizedPath(lang, "/");

// Hero slideshow · 3 PARES CURADOS · cada par es una composición
// editorial intencional, no random offset. Ambas mitades del diptych
// avanzan en sincronía (mismo índice), así el ojo lee "este par
// pertenece junto" en lugar de combinaciones que emergen del azar.
//
// `pos` es el background-position para el ambient blur layer atrás
// de cada slide.
const pairs = [
  // Par 1
  {
    left:  { src: cldImage(CLD_IDS.IMG_3041, 2400), pos: "center 50%" },
    right: { src: cldImage(CLD_IDS.IMG_3116, 2400), pos: "center 50%" },
  },
  // Par 2
  {
    left:  { src: cldImage(CLD_IDS.LIFE_INE_50, 2400), pos: "center 50%" },
    right: { src: cldImage(CLD_IDS.IMG_3115, 2400), pos: "center 50%" },
  },
  // Par 3
  {
    left:  { src: cldImage(CLD_IDS.IMG_3017, 2400), pos: "center 50%" },
    right: { src: cldImage(CLD_IDS.IMG_3051, 2400), pos: "center 50%" },
  },
];
---

<section class="hero" id="top">
  <div class="hero__split">
    <!-- LEFT half slideshow · renderiza el `left` de cada par. -->
    <div class="hero__half hero__half--left">
      {pairs.map((p, i) => (
        <div
          class:list={["hero__slide", "hero__slide--left", i === 0 && "active"]}
          style={`background-image:url('${p.left.src}'); background-position:${p.left.pos}`}
          data-slide={i}
        />
      ))}
    </div>

    <!-- RIGHT half slideshow · renderiza el `right` de cada par.
         Ambas mitades arrancan en index 0 (Par 1 inicial) y avanzan
         sincronizadas — no hay offset. -->
    <div class="hero__half hero__half--right" aria-hidden="true">
      {pairs.map((p, i) => (
        <div
          class:list={["hero__slide", "hero__slide--right", i === 0 && "active"]}
          style={`background-image:url('${p.right.src}'); background-position:${p.right.pos}`}
          data-slide={i}
        />
      ))}
    </div>

    <!-- Hairline that separates the two halves -->
    <span class="hero__divider" aria-hidden="true"></span>
  </div>

  <div class="hero__overlay"></div>

  <div class="hero__progress" id="heroProgress" aria-hidden="true">
    <span></span>
  </div>

  <div class="hero__content">
    <span class="hero__eyebrow">{t("hero.eyebrow")}</span>
    <h1 class="hero__title">
      <span class="line">{t("hero.title_1")}</span>
      <span class="line italic">{t("hero.title_2")}</span>
    </h1>
    <div class="hero__cta">
      <a href={`${home}#coleccion`} class="hero__btn hero__btn--primary">
        <span>{t("hero.cta_1")}</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true">
          <path d="M5 12h14M13 5l7 7-7 7"/>
        </svg>
      </a>
      <a href={`${home}#galeria`} class="hero__btn hero__btn--ghost">
        <span>{t("hero.cta_2")}</span>
      </a>
    </div>
  </div>

  <!-- Brand moment · the story opener.
       Hidden by default; heroExit.ts fades it in at the climax of the
       pin (after the shrunken halves have settled and the bg is paper)
       and dispatches `hb:hero-story-cue` once — that event triggers
       the typewriter below to start writing the opening line of the
       Horse Brand narrative, character by character.

       Why a typewriter here:
         · The user explicitly asked for "una frase que se escriba
           como la primera portada, como el cuento o la historia que
           comienza" — a sentence that writes itself, the story
           beginning.
         · Earlier iterations placed the brand logo or a chapter
           marker here; both read as a static title plate. A line that
           types itself feels actively narrative — the brand finishing
           its introduction and starting its story right before the
           Manifesto develops it.
         · Mirrors the typewriter device the Craft section uses for
           its closing line, so the brand language is consistent:
           "the page writes the words you're about to read".

       The text content is left empty in markup; the script at the
       bottom of this file reads it from `data-text` and types it
       into `[data-hero-story-target]` letter by letter. A blinking
       caret signals the act of writing; it stops blinking + fades
       once the line is complete.

       The shrunken diptych sits ABOVE this row (Phase 4 of heroExit
       only lifts it yPercent -10, so it stays clearly visible). The
       photo plate is the visual; this line is the voice. z-index 4
       keeps the moment above the halves. -->
  <div class="hero__brand-moment" data-hero-brand aria-hidden="true">
    <p
      class="hero__story"
      data-hero-story
      data-text={t("hero.story_opener")}
    >
      <span class="hero__story-text" data-hero-story-target></span><span
        class="hero__story-caret"
        aria-hidden="true"
      ></span>
    </p>
  </div>
</section>

<script>
  import { onPageReady } from "@/lib/onPageReady";

  function wireHero(): void {
    const hero = document.querySelector<HTMLElement>(".hero");
    const leftSlides = document.querySelectorAll<HTMLElement>(".hero__slide--left");
    const rightSlides = document.querySelectorAll<HTMLElement>(".hero__slide--right");
    const content = document.querySelector<HTMLElement>(".hero__content");
    if (!hero || !leftSlides.length) return;

    const N = leftSlides.length;
    const SLIDE_MS = 7500;
    const POST_INTRO_BUFFER_MS = 3400;
    const progress = document.getElementById("heroProgress");

    // Pares curados · ambos lados avanzan al mismo índice (sin offset).
    // Cada cambio muestra el siguiente par como una unidad editorial.
    let idxL = 0;
    let idxR = 0;
    let slideId: number | null = null;
    let started = false;

    function startProgress(): void {
      if (!progress) return;
      progress.classList.remove("run");
      void progress.offsetWidth;
      progress.classList.add("run");
    }

    // Cinema-cut crossfade. The previous slide KEEPS .active during the
    // fade-out so its Ken Burns animation continues drifting (instead of
    // snapping back to the keyframe-0 scale on class removal). After the
    // fade duration we strip both classes so the slide returns to its
    // base hidden pose and is ready for its next cycle as the incoming.
    const FADE_MS = 1600;
    function switchSlide(
      collection: NodeListOf<HTMLElement>,
      prev: number,
      next: number
    ): void {
      if (prev === next) return;
      const prevEl = collection[prev];
      const nextEl = collection[next];
      // Add .leaving (opacity → 0) while keeping .active so the Ken Burns
      // animation keeps running through the fade-out.
      prevEl.classList.add("leaving");
      // Activate the next slide — its CSS animation starts from scale 1.06,
      // settles to 1, then drifts to 1.05 over the slide hold.
      nextEl.classList.remove("leaving");
      nextEl.classList.add("active");
      // Strip .active + .leaving from the previous slide once its fade
      // completes. Use a captured ref so a fast re-cycle doesn't strip
      // the wrong slide.
      window.setTimeout(() => {
        prevEl.classList.remove("active");
        prevEl.classList.remove("leaving");
      }, FADE_MS);
    }

    function go(n: number): void {
      const prevL = idxL;
      const prevR = idxR;
      // Ambas mitades avanzan al mismo índice — los pares quedan
      // sincronizados (Par 1 → Par 2 → Par 3 → loop).
      const next = (n + N) % N;
      idxL = next;
      idxR = next;
      switchSlide(leftSlides, prevL, idxL);
      switchSlide(rightSlides, prevR, idxR);
      startProgress();
    }

    function startSlideshow(): void {
      if (started) return;
      started = true;
      startProgress();
      slideId = window.setInterval(() => go(idxL + 1), SLIDE_MS);
    }

    // Pause / resume the slideshow during the Hero→Manifesto pin so the
    // photo the user "engaged with" stays the one they see all the way
    // through the diptych close. heroExit.ts dispatches these events when
    // pin progress crosses ~5% (in either direction). Without the pause,
    // the slideshow could cycle to a different photo mid-transition and
    // the visual continuity of the gesture breaks.
    function pauseSlideshow(): void {
      if (slideId !== null) {
        window.clearInterval(slideId);
        slideId = null;
      }
    }
    function resumeSlideshow(): void {
      if (slideId === null && started) {
        slideId = window.setInterval(() => go(idxL + 1), SLIDE_MS);
        startProgress();
      }
    }
    document.addEventListener("hb:hero-leaving", pauseSlideshow);
    document.addEventListener("hb:hero-arrived", resumeSlideshow);

    function whenIntroDone(cb: () => void): void {
      if (document.body.classList.contains("intro-done")) cb();
      else window.addEventListener("hb:intro-done", cb, { once: true });
    }

    whenIntroDone(() => {
      window.setTimeout(startSlideshow, POST_INTRO_BUFFER_MS);
    });

    // ---- cursor parallax (desktop only) ----
    // Only the CONTENT block drifts subtly with the cursor. The image
    // halves stay still — the previous version moved them per-half and
    // it felt heavy / read as a glitch. The lerp at 0.08 per frame
    // produces the soft easing without CSS transitions.
    let raf: number | null = null;
    const noHover = window.matchMedia("(hover: none)").matches;
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    if (!noHover && !reduced && content) {
      const CONTENT_RANGE = 5;
      let cxT = 0, cyT = 0;
      let cx = 0, cy = 0;

      function tick(): void {
        cx += (cxT - cx) * 0.08;
        cy += (cyT - cy) * 0.08;
        content!.style.setProperty("--ptx", `${cx.toFixed(2)}px`);
        content!.style.setProperty("--pty", `${cy.toFixed(2)}px`);
        const moving =
          Math.abs(cxT - cx) > 0.1 || Math.abs(cyT - cy) > 0.1;
        raf = moving ? requestAnimationFrame(tick) : null;
      }

      function onMove(e: PointerEvent): void {
        const rect = hero!.getBoundingClientRect();
        const px = (e.clientX - rect.left) / rect.width - 0.5;
        const py = (e.clientY - rect.top) / rect.height - 0.5;
        cxT = px * CONTENT_RANGE * 2;
        cyT = py * CONTENT_RANGE * 2;
        if (raf === null) raf = requestAnimationFrame(tick);
      }
      function onLeave(): void {
        cxT = cyT = 0;
        if (raf === null) raf = requestAnimationFrame(tick);
      }

      hero.addEventListener("pointermove", onMove);
      hero.addEventListener("pointerleave", onLeave);
    }

    /* ---- Story-opener typewriter ----
     * heroExit.ts dispatches `hb:hero-story-cue` once when the pin's
     * progress crosses ~78% — that's the moment the shrunken diptych
     * has settled and the brand moment is fading in. We then write
     * the localized opener phrase character by character into the
     * `[data-hero-story-target]` span.
     *
     * The caret blink + post-typing fade are CSS-driven via the
     * `.is-typing` / `.is-typed` modifiers on the brand-moment.
     *
     * Reduced-motion path: paint the whole line immediately, no
     * per-char interval, no caret animation — the CSS already hides
     * the caret in that mode.
     *
     * Idempotency: the routine self-guards via the `data-typed`
     * attribute so a duplicate cue (e.g. user scrolls back and
     * forward across the threshold) doesn't restart the typing
     * mid-render. */
    const STORY_SPEED_MS = 55;   // per character — feels deliberate, not slow
    const STORY_START_DELAY = 350; // small beat before the line begins
    function runStoryTypewriter(): void {
      const brandMoment = document.querySelector<HTMLElement>(
        "[data-hero-brand]"
      );
      const target = document.querySelector<HTMLElement>(
        "[data-hero-story-target]"
      );
      const source = document.querySelector<HTMLElement>("[data-hero-story]");
      if (!brandMoment || !target || !source) return;
      if (brandMoment.dataset.typed === "1") return;
      brandMoment.dataset.typed = "1";

      const text = source.dataset.text ?? "";
      if (!text) return;

      const reduced = window.matchMedia(
        "(prefers-reduced-motion: reduce)"
      ).matches;
      if (reduced) {
        target.textContent = text;
        brandMoment.classList.add("is-typed");
        return;
      }

      brandMoment.classList.add("is-typing");
      let i = 0;
      const id = window.setTimeout(function step(): void {
        if (i < text.length) {
          target.textContent = text.substring(0, i + 1);
          i += 1;
          window.setTimeout(step, STORY_SPEED_MS);
        } else {
          brandMoment.classList.remove("is-typing");
          brandMoment.classList.add("is-typed");
        }
      }, STORY_START_DELAY);

      // Stop the chain on SPA navigation to avoid orphan timers.
      document.addEventListener(
        "astro:before-swap",
        () => window.clearTimeout(id),
        { once: true }
      );
    }
    document.addEventListener("hb:hero-story-cue", runStoryTypewriter, {
      once: true,
    });

    document.addEventListener(
      "astro:before-swap",
      () => {
        if (slideId !== null) window.clearInterval(slideId);
        if (raf !== null) cancelAnimationFrame(raf);
        document.removeEventListener("hb:hero-leaving", pauseSlideshow);
        document.removeEventListener("hb:hero-arrived", resumeSlideshow);
        document.removeEventListener("hb:hero-story-cue", runStoryTypewriter);
      },
      { once: true }
    );
  }
  onPageReady(wireHero);
</script>

<style>
  .hero {
    position: relative;
    height: 100vh;
    height: 100dvh;
    min-height: 680px;
    overflow: hidden;
    color: #f7f3ec;
    background: var(--color-ink);
  }

  /* ---- Split layout · 50/50 diptych ---- */
  /* heroExit.ts animates THIS wrapper (scale + opacity) as a single unit
     during the Hero→Manifesto close, so it gets the will-change. Inner
     halves no longer carry a will-change — they're passive containers. */
  .hero__split {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    will-change: transform, opacity;
  }

  .hero__half {
    position: relative;
    overflow: hidden;
  }

  /* Hairline divider between halves — subtle gold accent at the seam */
  .hero__divider {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 1px;
    background: linear-gradient(to bottom,
      rgba(247, 243, 236, 0) 0%,
      rgba(247, 243, 236, 0.18) 30%,
      rgba(247, 243, 236, 0.18) 70%,
      rgba(247, 243, 236, 0) 100%);
    z-index: 2;
    pointer-events: none;
  }

  /* ---- Slides · Cinema Cut + Ken Burns ----
   * Each half is 50vw × 100vh on desktop — already a portrait container.
   *
   * Two-phase motion, separated cleanly so they don't fight each other:
   *   PHASE A · "Settle"  (CSS transition, 1.6s)
   *     Triggered by toggling .active. Opacity 0 → 1 and scale 1.06 → 1
   *     run together — the new slide arrives slightly oversized and
   *     eases inward into its rest pose. This gives the cinematic
   *     "camera adjust" feel without a separate keyframe fighting the
   *     fade.
   *
   *   PHASE B · "Drift"  (CSS animation, 5.9s linear, starts 1.6s after
   *     the active class lands)
   *     Once the slide has settled at scale 1, a continuous slow drift
   *     to scale 1.05 runs over the remainder of the slide hold. This is
   *     the Ken Burns "breath" that keeps the still frame alive between
   *     transitions.
   *
   * Total: 1.6s (settle) + 5.9s (drift) = 7.5s, matches SLIDE_HOLD_MS so
   * the next slide enters exactly at peak scale — cleanest possible
   * "camera between shots" handoff.
   *
   * Exit: .leaving is added (KEEPING .active so the drift animation keeps
   * the scale where it was), opacity 1 → 0 fades over 1.6s, then JS
   * strips both classes for the next cycle.
   *
   * The drift animation is GATED by `body.intro-done` so it doesn't start
   * during the IntroSplash (when the Hero is hidden anyway). Without the
   * gate, the first slide would visibly drift behind the splash and arrive
   * at scale ~1.02 when the splash dismissed.
   */
  .hero__slide {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-repeat: no-repeat;
    filter: saturate(0.94) contrast(1.04);
    /* Hidden base pose — slightly oversized so the entry settles inward */
    opacity: 0;
    transform: scale(1.06);
    transition: opacity 1.6s var(--ease-soft),
      transform 1.6s var(--ease-soft);
    will-change: opacity, transform;
  }
  .hero__slide.active {
    opacity: 1;
    transform: scale(1);
  }
  /* Drift only kicks in once intro-done is set so the first slide doesn't
     animate behind the splash. Animation goes from current scale (1) to
     1.05 over 5.9s, starting 1.6s after the class change so the "settle"
     transition completes first and the two motions don't overlap. */
  :global(body.intro-done) .hero__slide.active {
    animation: heroKenBurns 5.9s linear 1.6s forwards;
  }
  .hero__slide.leaving {
    /* .active still present → the drift animation keeps running and the
       scale stays at its current point. Only opacity fades out. */
    opacity: 0;
  }
  @keyframes heroKenBurns {
    to { transform: scale(1.05); }
  }

  /* Pin-freeze · while the Hero→Manifesto pin is active, freeze every
     motion inside the slides (Ken Burns animation AND the settle/leave
     transitions). The half wrapper is being scaled per-tick by GSAP, and
     compositing a parent-scale change with an in-flight child animation
     was the visible "shimmer/flicker". Pausing the inner animations
     leaves the GSAP transform on the half as the SOLE animator, so the
     image moves as a single rigid layer with its parent. The .active
     slide stays visible (Ken Burns is paused, not removed) so the photo
     the user engaged with travels with the close. */
  .hero.is-pinning .hero__slide {
    animation-play-state: paused !important;
    transition: none !important;
  }

  /* RIGHT half · cascades 0.35s after the LEFT on entry, so the eye reads
   * "left arrives, then right arrives". Leave runs immediately (no delay)
   * so both halves vacate together. */
  .hero__slide--right {
    transition: opacity 1.6s var(--ease-soft) 0.35s,
      transform 1.6s var(--ease-soft) 0.35s;
  }
  :global(body.intro-done) .hero__slide--right.active {
    /* 1.6s settle (delayed 0.35s for cascade) + tiny gap before drift */
    animation-delay: 1.95s;
  }
  .hero__slide--right.leaving {
    transition-delay: 0s;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__slide {
      transform: none;
      transition: opacity 0.5s linear;
    }
    .hero__slide.active {
      animation: none;
      transform: none;
    }
    .hero__slide:not(.active) { opacity: 0; }
  }

  /* ---- Overlay · scrim weighted to the bottom-left (where text lives) ---- */
  .hero__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      radial-gradient(ellipse 50% 55% at 22% 78%,
        rgba(15, 11, 8, 0.6) 0%,
        rgba(15, 11, 8, 0.3) 40%,
        transparent 75%),
      linear-gradient(to top right,
        rgba(15, 11, 8, 0.38) 0%,
        rgba(15, 11, 8, 0.1) 35%,
        transparent 60%);
    pointer-events: none;
  }

  /* Progress bar — 6.5s linear sweep, full width */
  .hero__progress {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: rgba(247, 243, 236, 0.16);
    z-index: 3;
    overflow: hidden;
  }
  .hero__progress span {
    display: block;
    height: 100%;
    width: 100%;
    background: rgba(247, 243, 236, 0.65);
    transform: scaleX(0);
    transform-origin: left center;
  }
  .hero__progress.run span {
    animation: heroProgress 7500ms linear forwards;
  }
  @keyframes heroProgress {
    from { transform: scaleX(0); }
    to   { transform: scaleX(1); }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__progress { display: none; }
  }

  /* ---- Content · anchored to bottom-LEFT over the left half ----
   * Width is `auto` so each title line decides its own width (each .line is
   * white-space: nowrap), keeping "El cuero recuerda." on a single line.
   * max-width caps the block for safety on narrow viewports. */
  .hero__content {
    position: absolute;
    bottom: 11vh;
    left: 6vw;
    transform: translate(var(--ptx, 0px), var(--pty, 0px));
    z-index: 2;
    width: auto;
    max-width: 56vw;
    text-align: left;
    will-change: transform;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  /* Eyebrow — sits above the title; line draws first, text fades after */
  .hero__eyebrow {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: 10px;
    letter-spacing: 0.6em;
    text-transform: uppercase;
    font-weight: 400;
    color: rgba(247, 243, 236, 0);
    margin-bottom: 20px;
  }
  :global(body.intro-done) .hero__eyebrow {
    animation: heroEyebrowText 0.8s var(--ease-editorial) 0.3s forwards;
  }
  .hero__eyebrow::before {
    content: "";
    display: inline-block;
    width: 0;
    height: 1px;
    background: rgba(247, 243, 236, 0.5);
    vertical-align: middle;
    margin-right: 14px;
    margin-bottom: 3px;
  }
  :global(body.intro-done) .hero__eyebrow::before {
    animation: heroEyebrowLine 0.7s var(--ease-editorial) 0.15s forwards;
  }
  @keyframes heroEyebrowLine {
    to { width: 28px; }
  }
  @keyframes heroEyebrowText {
    to {
      color: rgba(247, 243, 236, 0.78);
      letter-spacing: 0.5em;
    }
  }

  /* Title — clip-path rise per line, second line italic gold */
  .hero__title {
    font-family: var(--font-display);
    font-weight: 400;
    /* Antes 4.8vw cap 76 · las nuevas frases ("El caballo nos inspira."
     * y "Más que objetos: una actitud.") son más largas que las
     * anteriores y a 76px ocupaban demasiado en la portada. 3.5vw cap
     * 56 baja el peso visual ~25% manteniendo presencia editorial. */
    font-size: clamp(32px, 3.5vw, 56px);
    line-height: 1.05;
    letter-spacing: 0.005em;
    color: #f7f3ec;
    text-shadow: 0 4px 30px rgba(15, 11, 8, 0.45);
    margin: 0;
  }
  .hero__title .line {
    display: block;
    /* Keep each line on a single row — "El cuero recuerda." stays whole. */
    white-space: nowrap;
    padding: 0.08em 0.04em;
    margin: -0.08em -0.04em;
    clip-path: inset(100% 0 0 0);
    -webkit-clip-path: inset(100% 0 0 0);
    filter: blur(6px);
    transform: translateY(8px);
    will-change: clip-path, filter, transform;
  }
  :global(body.intro-done) .hero__title .line {
    animation: heroLineRise 1.2s var(--ease-editorial) forwards;
  }
  :global(body.intro-done) .hero__title .line:nth-child(1) { animation-delay: 0.55s; }
  :global(body.intro-done) .hero__title .line:nth-child(2) { animation-delay: 0.75s; }
  .hero__title .italic {
    font-family: var(--font-italic);
    font-style: italic;
    font-weight: 300;
    color: var(--color-gold);
  }
  @keyframes heroLineRise {
    0% {
      clip-path: inset(100% 0 0 0);
      -webkit-clip-path: inset(100% 0 0 0);
      filter: blur(6px);
      transform: translateY(8px);
    }
    60% { filter: blur(2px); }
    100% {
      clip-path: inset(0 0 0 0);
      -webkit-clip-path: inset(0 0 0 0);
      filter: blur(0);
      transform: translateY(0);
    }
  }

