---
import { type Lang, useTranslations } from "@/i18n/ui";
import { localizedPath } from "@/i18n/utils";
import { cldImage } from "@/lib/cloudinary";
import { CLD_IDS } from "@/lib/cloudinaryAssets";

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const home = localizedPath(lang, "/");

// Hero slideshow — 5 editorial shots from the book.
// Order is intentional: principal → emocional → moderno → elegante → lifestyle.
// pos is the background-position for the ambient blur layer.
const slides = [
  { src: cldImage(CLD_IDS.IMG_3017, 2400), pos: "center 50%" }, // 01 · principal
  { src: cldImage(CLD_IDS.IMG_3092, 2400), pos: "55% 45%" },    // 02 · emocional
  { src: cldImage(CLD_IDS.IMG_3104, 2400), pos: "62% 38%" },    // 03 · moderno
  { src: cldImage(CLD_IDS.IMG_2955, 2400), pos: "center 50%" }, // 04 · elegante
  { src: cldImage(CLD_IDS.IMG_3041, 2400), pos: "65% 50%" },    // 05 · lifestyle
];

// Right half starts offset from the left, so the two halves never show the
// same image and cycle through all 5 without collisions.
const RIGHT_INITIAL = 2;
---

<section class="hero" id="top">
  <div class="hero__split">
    <!-- LEFT half slideshow -->
    <div class="hero__half hero__half--left">
      {slides.map((s, i) => (
        <div
          class:list={["hero__slide", "hero__slide--left", i === 0 && "active"]}
          style={`background-image:url('${s.src}'); background-position:${s.pos}`}
          data-slide={i}
        />
      ))}
    </div>

    <!-- RIGHT half slideshow (only renders on desktop ≥701px via CSS) -->
    <div class="hero__half hero__half--right" aria-hidden="true">
      {slides.map((s, i) => (
        <div
          class:list={["hero__slide", "hero__slide--right", i === RIGHT_INITIAL && "active"]}
          style={`background-image:url('${s.src}'); background-position:${s.pos}`}
          data-slide={i}
        />
      ))}
    </div>

    <!-- Hairline that separates the two halves -->
    <span class="hero__divider" aria-hidden="true"></span>
  </div>

  <div class="hero__overlay"></div>

  <div class="hero__progress" id="heroProgress" aria-hidden="true">
    <span></span>
  </div>

  <div class="hero__content">
    <span class="hero__eyebrow">{t("hero.eyebrow")}</span>
    <h1 class="hero__title">
      <span class="line">{t("hero.title_1")}</span>
      <span class="line italic">{t("hero.title_2")}</span>
    </h1>
    <div class="hero__cta">
      <a href={`${home}#coleccion`} class="hero__btn hero__btn--primary">
        <span>{t("hero.cta_1")}</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true">
          <path d="M5 12h14M13 5l7 7-7 7"/>
        </svg>
      </a>
      <a href={`${home}#galeria`} class="hero__btn hero__btn--ghost">
        <span>{t("hero.cta_2")}</span>
      </a>
    </div>
  </div>

  <a href="#manifiesto" class="hero__scroll" aria-label={t("hero.scroll")}>
    <span class="hero__scroll-text">{t("hero.scroll")}</span>
    <span class="hero__scroll-line" aria-hidden="true"></span>
  </a>
</section>

<script>
  import { onPageReady } from "@/lib/onPageReady";

  function wireHero(): void {
    const hero = document.querySelector<HTMLElement>(".hero");
    const leftSlides = document.querySelectorAll<HTMLElement>(".hero__slide--left");
    const rightSlides = document.querySelectorAll<HTMLElement>(".hero__slide--right");
    const content = document.querySelector<HTMLElement>(".hero__content");
    if (!hero || !leftSlides.length) return;

    const N = leftSlides.length;
    const RIGHT_OFFSET = 2;
    const SLIDE_MS = 7500;
    const POST_INTRO_BUFFER_MS = 3400;
    const progress = document.getElementById("heroProgress");

    let idxL = 0;
    let idxR = RIGHT_OFFSET % N;
    let slideId: number | null = null;
    let started = false;

    function startProgress(): void {
      if (!progress) return;
      progress.classList.remove("run");
      void progress.offsetWidth;
      progress.classList.add("run");
    }

    function switchSlide(
      collection: NodeListOf<HTMLElement>,
      prev: number,
      next: number
    ): void {
      if (prev === next) return;
      collection[prev].classList.remove("active");
      collection[prev].classList.add("leaving");
      collection[next].classList.remove("leaving");
      collection[next].classList.add("active");
    }

    function go(n: number): void {
      const prevL = idxL;
      const prevR = idxR;
      idxL = (n + N) % N;
      idxR = (n + RIGHT_OFFSET + N) % N;
      switchSlide(leftSlides, prevL, idxL);
      switchSlide(rightSlides, prevR, idxR);
      startProgress();
    }

    function startSlideshow(): void {
      if (started) return;
      started = true;
      startProgress();
      slideId = window.setInterval(() => go(idxL + 1), SLIDE_MS);
    }

    function whenIntroDone(cb: () => void): void {
      if (document.body.classList.contains("intro-done")) cb();
      else window.addEventListener("hb:intro-done", cb, { once: true });
    }

    whenIntroDone(() => {
      window.setTimeout(startSlideshow, POST_INTRO_BUFFER_MS);
    });

    // ---- cursor parallax (desktop only) ----
    // Each half drifts independently — only the half UNDER the cursor moves.
    // The other half rests at origin. Content drifts subtly in the same
    // direction as the cursor so the text feels "alive". The lerp at 0.08
    // per frame produces the soft easing without CSS transitions.
    let raf: number | null = null;
    const noHover = window.matchMedia("(hover: none)").matches;
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const leftHalf = document.querySelector<HTMLElement>(".hero__half--left");
    const rightHalf = document.querySelector<HTMLElement>(".hero__half--right");

    if (!noHover && !reduced && content && leftHalf && rightHalf) {
      const MEDIA_RANGE = 10;
      const CONTENT_RANGE = 5;
      // Target offsets (set by pointermove), current offsets (animated by tick)
      let lxT = 0, lyT = 0, rxT = 0, ryT = 0, cxT = 0, cyT = 0;
      let lx = 0, ly = 0, rx = 0, ry = 0, cx = 0, cy = 0;

      function tick(): void {
        lx += (lxT - lx) * 0.08;
        ly += (lyT - ly) * 0.08;
        rx += (rxT - rx) * 0.08;
        ry += (ryT - ry) * 0.08;
        cx += (cxT - cx) * 0.08;
        cy += (cyT - cy) * 0.08;
        leftHalf!.style.transform = `translate3d(${lx.toFixed(2)}px, ${ly.toFixed(2)}px, 0)`;
        rightHalf!.style.transform = `translate3d(${rx.toFixed(2)}px, ${ry.toFixed(2)}px, 0)`;
        content!.style.setProperty("--ptx", `${cx.toFixed(2)}px`);
        content!.style.setProperty("--pty", `${cy.toFixed(2)}px`);
        const moving =
          Math.abs(lxT - lx) > 0.1 || Math.abs(lyT - ly) > 0.1 ||
          Math.abs(rxT - rx) > 0.1 || Math.abs(ryT - ry) > 0.1 ||
          Math.abs(cxT - cx) > 0.1 || Math.abs(cyT - cy) > 0.1;
        raf = moving ? requestAnimationFrame(tick) : null;
      }

      function onMove(e: PointerEvent): void {
        const rect = hero!.getBoundingClientRect();
        const localX = e.clientX - rect.left;
        const px = localX / rect.width - 0.5;
        const py = (e.clientY - rect.top) / rect.height - 0.5;

        // Which half is the cursor over?
        const onLeft = localX < rect.width / 2;
        const drift = -px * MEDIA_RANGE * 2;
        const driftY = -py * MEDIA_RANGE * 2;

        if (onLeft) {
          lxT = drift;
          lyT = driftY;
          rxT = 0;
          ryT = 0;
        } else {
          rxT = drift;
          ryT = driftY;
          lxT = 0;
          lyT = 0;
        }
        cxT = px * CONTENT_RANGE * 2;
        cyT = py * CONTENT_RANGE * 2;
        if (raf === null) raf = requestAnimationFrame(tick);
      }
      function onLeave(): void {
        lxT = lyT = rxT = ryT = cxT = cyT = 0;
        if (raf === null) raf = requestAnimationFrame(tick);
      }

      hero.addEventListener("pointermove", onMove);
      hero.addEventListener("pointerleave", onLeave);
    }

    document.addEventListener(
      "astro:before-swap",
      () => {
        if (slideId !== null) window.clearInterval(slideId);
        if (raf !== null) cancelAnimationFrame(raf);
      },
      { once: true }
    );
  }
  onPageReady(wireHero);
</script>

<style>
  .hero {
    position: relative;
    height: 100vh;
    height: 100dvh;
    min-height: 680px;
    overflow: hidden;
    color: #f7f3ec;
    background: var(--color-ink);
  }

  /* ---- Split layout · 50/50 diptych ---- */
  .hero__split {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
  }

  .hero__half {
    position: relative;
    overflow: hidden;
    will-change: transform;
  }

  /* Hairline divider between halves — subtle gold accent at the seam */
  .hero__divider {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 1px;
    background: linear-gradient(to bottom,
      rgba(247, 243, 236, 0) 0%,
      rgba(247, 243, 236, 0.18) 30%,
      rgba(247, 243, 236, 0.18) 70%,
      rgba(247, 243, 236, 0) 100%);
    z-index: 2;
    pointer-events: none;
  }

  /* ---- Slides · cover the half cleanly ----
   * Each half is 50vw × 100vh on desktop — already a portrait container.
   * No breathing zoom: photos stay STILL during the hold (more architectural,
   * less commercial). The reveal is handled by clip-path, anchored to the
   * central divider: each new photo emerges FROM the divider toward the
   * outer edge of its half — like a double page spreading open.
   */
  .hero__slide {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-repeat: no-repeat;
    will-change: clip-path;
    /* Left and right have mirrored anchor states (see below). */
  }

  /* LEFT half · slide anchored at the divider (right edge of its container).
   * 1.8s soft easing — quiet, slow, deliberate. Marks elegance, not energy. */
  .hero__slide--left {
    clip-path: inset(0 0 0 100%);
    -webkit-clip-path: inset(0 0 0 100%);
    transition: clip-path 1.8s var(--ease-soft);
  }
  .hero__slide--left.active {
    clip-path: inset(0 0 0 0);
    -webkit-clip-path: inset(0 0 0 0);
  }
  .hero__slide--left.leaving {
    clip-path: inset(0 0 0 100%);
    -webkit-clip-path: inset(0 0 0 100%);
  }

  /* RIGHT half · mirrored. The right also runs 0.35s LATER on entry only,
   * so the eye reads: left opens, then right cascades from the divider. */
  .hero__slide--right {
    clip-path: inset(0 100% 0 0);
    -webkit-clip-path: inset(0 100% 0 0);
    transition: clip-path 1.8s var(--ease-soft) 0.35s;
  }
  .hero__slide--right.active {
    clip-path: inset(0 0 0 0);
    -webkit-clip-path: inset(0 0 0 0);
  }
  .hero__slide--right.leaving {
    clip-path: inset(0 100% 0 0);
    -webkit-clip-path: inset(0 100% 0 0);
    transition-delay: 0s;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__slide,
    .hero__slide--left,
    .hero__slide--right,
    .hero__slide--left.active,
    .hero__slide--right.active,
    .hero__slide--left.leaving,
    .hero__slide--right.leaving {
      clip-path: inset(0 0 0 0);
      -webkit-clip-path: inset(0 0 0 0);
      opacity: 1;
      transition: opacity 0.5s linear;
    }
    .hero__slide:not(.active) { opacity: 0; }
  }

  /* ---- Overlay · scrim weighted to the bottom-left (where text lives) ---- */
  .hero__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      radial-gradient(ellipse 50% 55% at 22% 78%,
        rgba(15, 11, 8, 0.6) 0%,
        rgba(15, 11, 8, 0.3) 40%,
        transparent 75%),
      linear-gradient(to top right,
        rgba(15, 11, 8, 0.38) 0%,
        rgba(15, 11, 8, 0.1) 35%,
        transparent 60%);
    pointer-events: none;
  }

  /* Progress bar — 6.5s linear sweep, full width */
  .hero__progress {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: rgba(247, 243, 236, 0.16);
    z-index: 3;
    overflow: hidden;
  }
  .hero__progress span {
    display: block;
    height: 100%;
    width: 100%;
    background: rgba(247, 243, 236, 0.65);
    transform: scaleX(0);
    transform-origin: left center;
  }
  .hero__progress.run span {
    animation: heroProgress 7500ms linear forwards;
  }
  @keyframes heroProgress {
    from { transform: scaleX(0); }
    to   { transform: scaleX(1); }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__progress { display: none; }
  }

  /* ---- Content · anchored to bottom-LEFT over the left half ----
   * Width is `auto` so each title line decides its own width (each .line is
   * white-space: nowrap), keeping "El cuero recuerda." on a single line.
   * max-width caps the block for safety on narrow viewports. */
  .hero__content {
    position: absolute;
    bottom: 11vh;
    left: 6vw;
    transform: translate(var(--ptx, 0px), var(--pty, 0px));
    z-index: 2;
    width: auto;
    max-width: 56vw;
    text-align: left;
    will-change: transform;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  /* Eyebrow — sits above the title; line draws first, text fades after */
  .hero__eyebrow {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: 10px;
    letter-spacing: 0.6em;
    text-transform: uppercase;
    font-weight: 400;
    color: rgba(247, 243, 236, 0);
    margin-bottom: 20px;
  }
  :global(body.intro-done) .hero__eyebrow {
    animation: heroEyebrowText 1s var(--ease-editorial) 0.8s forwards;
  }
  .hero__eyebrow::before {
    content: "";
    display: inline-block;
    width: 0;
    height: 1px;
    background: rgba(247, 243, 236, 0.5);
    vertical-align: middle;
    margin-right: 14px;
    margin-bottom: 3px;
  }
  :global(body.intro-done) .hero__eyebrow::before {
    animation: heroEyebrowLine 0.9s var(--ease-editorial) 0.45s forwards;
  }
  @keyframes heroEyebrowLine {
    to { width: 28px; }
  }
  @keyframes heroEyebrowText {
    to {
      color: rgba(247, 243, 236, 0.78);
      letter-spacing: 0.5em;
    }
  }

  /* Title — clip-path rise per line, second line italic gold */
  .hero__title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(36px, 4.8vw, 76px);
    line-height: 1.05;
    letter-spacing: 0.005em;
    color: #f7f3ec;
    text-shadow: 0 4px 30px rgba(15, 11, 8, 0.45);
    margin: 0;
  }
  .hero__title .line {
    display: block;
    /* Keep each line on a single row — "El cuero recuerda." stays whole. */
    white-space: nowrap;
    padding: 0.08em 0.04em;
    margin: -0.08em -0.04em;
    clip-path: inset(100% 0 0 0);
    -webkit-clip-path: inset(100% 0 0 0);
    filter: blur(6px);
    transform: translateY(8px);
    will-change: clip-path, filter, transform;
  }
  :global(body.intro-done) .hero__title .line {
    animation: heroLineRise 1.6s var(--ease-editorial) forwards;
  }
  :global(body.intro-done) .hero__title .line:nth-child(1) { animation-delay: 1.2s; }
  :global(body.intro-done) .hero__title .line:nth-child(2) { animation-delay: 1.55s; }
  .hero__title .italic {
    font-family: var(--font-italic);
    font-style: italic;
    font-weight: 300;
    color: var(--color-gold);
  }
  @keyframes heroLineRise {
    0% {
      clip-path: inset(100% 0 0 0);
      -webkit-clip-path: inset(100% 0 0 0);
      filter: blur(6px);
      transform: translateY(8px);
    }
    60% { filter: blur(2px); }
    100% {
      clip-path: inset(0 0 0 0);
      -webkit-clip-path: inset(0 0 0 0);
      filter: blur(0);
      transform: translateY(0);
    }
  }

  /* CTAs — horizontal mask reveal, aligned to the left of the block */
  .hero__cta {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    justify-content: flex-start;
    margin-top: 30px;
  }
  .hero__btn {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    padding: 16px 28px;
    font-family: var(--font-sans);
    font-size: 11.5px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    font-weight: 400;
    border: 1px solid currentColor;
    cursor: none;
    position: relative;
    overflow: hidden;
    clip-path: inset(0 100% 0 0);
    -webkit-clip-path: inset(0 100% 0 0);
    opacity: 0;
    transition: background 0.5s var(--ease-editorial),
      color 0.5s var(--ease-editorial),
      border-color 0.5s var(--ease-editorial),
      transform 0.5s var(--ease-soft);
  }
  :global(body.intro-done) .hero__btn {
    animation: heroBtnReveal 1.1s var(--ease-editorial) forwards;
  }
  :global(body.intro-done) .hero__cta a:nth-child(1) { animation-delay: 2.7s; }
  :global(body.intro-done) .hero__cta a:nth-child(2) { animation-delay: 2.85s; }
  @keyframes heroBtnReveal {
    to {
      clip-path: inset(0 0 0 0);
      -webkit-clip-path: inset(0 0 0 0);
      opacity: 1;
    }
  }
  .hero__btn svg {
    width: 14px;
    height: 14px;
    transition: transform 0.5s var(--ease-editorial);
  }
  .hero__btn:hover { transform: translateY(-2px); }
  .hero__btn:hover svg { transform: translateX(5px); }
  .hero__btn--primary {
    background: #f7f3ec;
    color: var(--color-ink);
    border-color: #f7f3ec;
  }
  .hero__btn--primary:hover {
    background: transparent;
    color: #f7f3ec;
  }
  .hero__btn--ghost {
    background: transparent;
    color: #f7f3ec;
    border-color: rgba(247, 243, 236, 0.5);
  }
  .hero__btn--ghost:hover {
    background: rgba(247, 243, 236, 0.08);
    border-color: #f7f3ec;
  }

  /* ---- Scroll indicator · bottom-right vertical ---- */
  .hero__scroll {
    position: absolute;
    bottom: 36px;
    right: 5vw;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    opacity: 0;
    transform: translateY(10px);
    color: rgba(247, 243, 236, 0.55);
    transition: color 0.4s, transform 0.4s var(--ease-soft);
  }
  :global(body.intro-done) .hero__scroll {
    animation: heroScrollIn 1s var(--ease-editorial) 3.1s forwards;
  }
  @keyframes heroScrollIn {
    to { opacity: 1; transform: translateY(0); }
  }
  .hero__scroll:hover {
    color: rgba(247, 243, 236, 0.95);
    transform: translateY(-2px);
  }
  .hero__scroll-text {
    font-family: var(--font-sans);
    font-size: 9.5px;
    letter-spacing: 0.5em;
    text-transform: uppercase;
    writing-mode: vertical-rl;
    text-orientation: mixed;
  }
  .hero__scroll-line {
    position: relative;
    width: 1px;
    height: 44px;
    background: linear-gradient(to bottom,
      rgba(247, 243, 236, 0.5),
      rgba(247, 243, 236, 0));
    overflow: hidden;
  }
  .hero__scroll-line::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 14px;
    background: linear-gradient(to bottom,
      transparent,
      rgba(247, 243, 236, 0.95),
      transparent);
    animation: heroScrollPulse 1.9s var(--ease-soft) infinite;
  }
  @keyframes heroScrollPulse {
    0%   { transform: translateY(-14px); opacity: 0; }
    25%  { opacity: 1; }
    75%  { opacity: 1; }
    100% { transform: translateY(44px); opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__scroll-line::after { animation: none; opacity: 0.5; }
  }

  /* ---------- MOBILE (≤700px) ----------
   * Split collapses: only the LEFT half is shown, full-width.
   * The right half is removed from layout to keep mobile light (one slideshow
   * is enough on small screens; the diptych is a desktop-scale composition).
   */
  @media (max-width: 700px) {
    .hero__split { grid-template-columns: 1fr; }
    .hero__half--right { display: none; }
    .hero__divider { display: none; }

    /* On mobile there's no split → text anchors bottom-left, full-width. */
    .hero__content {
      right: auto;
      left: 7vw;
      bottom: 9vh;
      transform: translate(var(--ptx, 0px), var(--pty, 0px));
      width: 86vw;
      text-align: left;
      align-items: flex-start;
    }
    .hero__title { font-size: clamp(38px, 9vw, 64px); }
    .hero__eyebrow { font-size: 9.5px; letter-spacing: 0.42em; margin-bottom: 22px; }
    .hero__cta { margin-top: 32px; gap: 10px; justify-content: flex-start; }
    .hero__btn { padding: 14px 22px; font-size: 10.5px; letter-spacing: 0.24em; }

    .hero__scroll { display: none; }

    /* Mobile only has left slides — they wipe horizontally from the right
     * edge inward (since there's no divider, the anchor is the visual edge). */
    .hero__slide--left {
      clip-path: inset(0 100% 0 0);
      -webkit-clip-path: inset(0 100% 0 0);
    }
    .hero__slide--left.active {
      clip-path: inset(0 0 0 0);
      -webkit-clip-path: inset(0 0 0 0);
    }
    .hero__slide--left.leaving {
      clip-path: inset(0 0 0 100%);
      -webkit-clip-path: inset(0 0 0 100%);
    }
  }

  @media (max-width: 400px) {
    .hero__content { width: 88vw; }
    .hero__title { font-size: clamp(32px, 10vw, 48px); }
    .hero__cta {
      flex-direction: column;
      align-items: stretch;
      width: 100%;
    }
    .hero__btn {
      justify-content: center;
      width: 100%;
    }
    .hero__progress { height: 2px; }
  }
</style>
