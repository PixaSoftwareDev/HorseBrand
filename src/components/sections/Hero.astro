---
import { type Lang, useTranslations } from "@/i18n/ui";
import { localizedPath } from "@/i18n/utils";
import { cldImage } from "@/lib/cloudinary";
import { CLD_IDS } from "@/lib/cloudinaryAssets";

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const home = localizedPath(lang, "/");

const slides = [
  { src: cldImage(CLD_IDS.IMG_3104, 2400), pos: "62% 38%" },
  { src: cldImage(CLD_IDS.IMG_2977, 2400), pos: "center 50%" },
  { src: cldImage(CLD_IDS.IMG_3041, 2400), pos: "65% 50%" },
  { src: cldImage(CLD_IDS.IMG_3092, 2400), pos: "55% 45%" },
];
---

<section class="hero" id="top">
  <div class="hero__media">
    {slides.map((s, i) => (
      <div
        class:list={["hero__slide", i === 0 && "active"]}
        style={`background-image:url('${s.src}'); background-position:${s.pos}`}
        data-slide={i}
      />
    ))}
  </div>
  <div class="hero__overlay"></div>

  <div class="hero__progress" id="heroProgress" aria-hidden="true">
    <span></span>
  </div>

  <div class="hero__content">
    <h1 class="hero__title">
      <span class="line">{t("hero.title_1")}</span>
      <span class="line italic">{t("hero.title_2")}</span>
    </h1>
    <span class="hero__eyebrow">{t("hero.eyebrow")}</span>
    <div class="hero__cta">
      <a href={`${home}#coleccion`} class="hero__btn hero__btn--primary">
        <span>{t("hero.cta_1")}</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true">
          <path d="M5 12h14M13 5l7 7-7 7"/>
        </svg>
      </a>
      <a href={`${home}#galeria`} class="hero__btn hero__btn--ghost">
        <span>{t("hero.cta_2")}</span>
      </a>
    </div>
  </div>
</section>

<script>
  function wireHero(): void {
    const hero = document.querySelector<HTMLElement>(".hero");
    const slides = document.querySelectorAll<HTMLElement>(".hero__slide");
    const media = document.querySelector<HTMLElement>(".hero__media");
    const content = document.querySelector<HTMLElement>(".hero__content");
    if (!hero || !slides.length) return;

    // ---- slideshow with cross-zoom transitions ----
    // Hold the first slide longer than subsequent ones so the user has time
    // to read the title + eyebrow + CTAs that are animating in.
    const SLIDE_MS = 6500;
    const POST_INTRO_BUFFER_MS = 3400; // ~ all entry animations finish
    const progress = document.getElementById("heroProgress");
    let idx = 0;
    let slideId: number | null = null;
    let started = false;

    function startProgress(): void {
      if (!progress) return;
      progress.classList.remove("run");
      // force reflow so the animation re-triggers cleanly.
      void progress.offsetWidth;
      progress.classList.add("run");
    }

    function go(n: number): void {
      const prev = idx;
      idx = (n + slides.length) % slides.length;
      if (prev === idx) return;
      // Outgoing → leaving (zoom-out + blur + fade out)
      slides[prev].classList.remove("active");
      slides[prev].classList.add("leaving");
      // Incoming → active (zoom-in + sharp + fade in)
      slides[idx].classList.remove("leaving");
      slides[idx].classList.add("active");
      startProgress();
    }

    function startSlideshow(): void {
      if (started) return;
      started = true;
      startProgress();
      slideId = window.setInterval(() => go(idx + 1), SLIDE_MS);
    }

    function whenIntroDone(cb: () => void): void {
      if (document.body.classList.contains("intro-done")) cb();
      else window.addEventListener("hb:intro-done", cb, { once: true });
    }

    whenIntroDone(() => {
      window.setTimeout(startSlideshow, POST_INTRO_BUFFER_MS);
    });

    // ---- cursor parallax (desktop only) ----
    let raf: number | null = null;
    const noHover = window.matchMedia("(hover: none)").matches;
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    if (!noHover && !reduced && media && content) {
      const MEDIA_RANGE = 28;     // px max desplazamiento de la imagen
      const CONTENT_RANGE = 14;   // px max desplazamiento del título
      let tx = 0, ty = 0;          // target imagen
      let cxT = 0, cyT = 0;        // target contenido
      let mx = 0, my = 0;          // current imagen (lerp)
      let cx = 0, cy = 0;          // current contenido (lerp)

      function tick(): void {
        mx += (tx - mx) * 0.08;
        my += (ty - my) * 0.08;
        cx += (cxT - cx) * 0.08;
        cy += (cyT - cy) * 0.08;
        media!.style.transform = `translate3d(${mx.toFixed(2)}px, ${my.toFixed(2)}px, 0)`;
        content!.style.transform = `translate3d(${cx.toFixed(2)}px, ${cy.toFixed(2)}px, 0)`;
        const moving =
          Math.abs(tx - mx) > 0.1 || Math.abs(ty - my) > 0.1 ||
          Math.abs(cxT - cx) > 0.1 || Math.abs(cyT - cy) > 0.1;
        raf = moving ? requestAnimationFrame(tick) : null;
      }

      function onMove(e: PointerEvent): void {
        const rect = hero!.getBoundingClientRect();
        const px = (e.clientX - rect.left) / rect.width - 0.5;
        const py = (e.clientY - rect.top) / rect.height - 0.5;
        // imagen: opuesto al cursor (paralaje "fondo")
        tx = -px * MEDIA_RANGE * 2;
        ty = -py * MEDIA_RANGE * 2;
        // contenido: mismo lado, mitad de magnitud (capa frontal)
        cxT = px * CONTENT_RANGE * 2;
        cyT = py * CONTENT_RANGE * 2;
        if (raf === null) raf = requestAnimationFrame(tick);
      }
      function onLeave(): void {
        tx = ty = cxT = cyT = 0;
        if (raf === null) raf = requestAnimationFrame(tick);
      }

      hero.addEventListener("pointermove", onMove);
      hero.addEventListener("pointerleave", onLeave);
    }

    document.addEventListener(
      "astro:before-swap",
      () => {
        if (slideId !== null) window.clearInterval(slideId);
        if (raf !== null) cancelAnimationFrame(raf);
      },
      { once: true }
    );
  }
  document.addEventListener("astro:page-load", wireHero);
</script>

<style>
  .hero {
    position: relative;
    height: 100vh;          /* fallback for older browsers */
    height: 100dvh;         /* iOS Safari address-bar safe */
    min-height: 680px;
    overflow: hidden;
    color: #f7f3ec;
  }
  .hero__media {
    position: absolute;
    inset: -4%;
    transition: transform 1.4s var(--ease-soft);
    will-change: transform;
  }
  /* Cinematic cross-zoom slides
   * - resting (no class): transparent, slightly zoomed-in + blurred (waiting to enter)
   * - .active: sharp, fully scaled-in, fully visible (long zoom-in over the slide hold)
   * - .leaving: pushed-out further with blur, fading away (saliente "se aleja")
   * Different timings per property: opacity is short (cross-fade), transform is long
   * (continuous "breathing"), filter is medium.
   */
  .hero__slide {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-repeat: no-repeat;
    opacity: 0;
    transform: scale(1.12);
    filter: blur(4px) saturate(0.95);
    will-change: opacity, transform, filter;
    transition:
      opacity 0.7s var(--ease-editorial),
      transform 4.6s var(--ease-soft),
      filter 0.5s var(--ease-editorial);
  }
  .hero__slide.active {
    opacity: 1;
    transform: scale(1);
    filter: blur(0) saturate(1);
  }
  .hero__slide.leaving {
    opacity: 0;
    transform: scale(1.16);
    filter: blur(5px) saturate(0.9);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__slide,
    .hero__slide.active,
    .hero__slide.leaving {
      transform: none;
      filter: none;
      transition: opacity 0.5s linear;
    }
  }
  .hero__overlay {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 60% 70% at left bottom,
        rgba(15, 11, 8, 0.78) 0%,
        rgba(15, 11, 8, 0.45) 25%,
        rgba(15, 11, 8, 0.15) 50%,
        transparent 70%),
      linear-gradient(to top, rgba(15, 11, 8, 0.25) 0%, transparent 22%);
  }

  /* Progress bar — fills in sync with the slide hold (6.5s) */
  .hero__progress {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: rgba(247, 243, 236, 0.16);
    z-index: 3;
    overflow: hidden;
  }
  .hero__progress span {
    display: block;
    height: 100%;
    width: 100%;
    background: rgba(247, 243, 236, 0.65);
    transform: scaleX(0);
    transform-origin: left center;
  }
  .hero__progress.run span {
    animation: heroProgress 6500ms linear forwards;
  }
  @keyframes heroProgress {
    from { transform: scaleX(0); }
    to   { transform: scaleX(1); }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__progress { display: none; }
  }

  .hero__content {
    position: absolute;
    bottom: 11vh;
    left: 5vw;
    z-index: 2;
    max-width: min(680px, 90vw);
    transition: transform 1.4s var(--ease-soft);
    will-change: transform;
  }

  /* ---------- HERO TITLE ----------
   * Each line is masked with clip-path from the bottom up (text "rises from
   * its baseline like ink") + a tiny blur fading out + 6px lift. Lines stagger
   * with 0.35s offset. Premium subtle reveal — Hermès editorial.
   */
  .hero__title {
    font-family: var(--font-italic);
    font-weight: 500;
    font-size: clamp(40px, 5.6vw, 86px);
    line-height: 1.04;
    letter-spacing: 0.005em;
    color: #f7f3ec;
    text-shadow: 0 2px 28px rgba(15, 11, 8, 0.4);
    margin-bottom: 0;
  }
  .hero__title .line {
    display: block;
    /* clip-path uses padding so descenders / accents are not cut off */
    padding: 0.08em 0.04em;
    margin: -0.08em -0.04em;
    clip-path: inset(100% 0 0 0);
    -webkit-clip-path: inset(100% 0 0 0);
    filter: blur(6px);
    transform: translateY(8px);
    will-change: clip-path, filter, transform;
  }
  :global(body.intro-done) .hero__title .line {
    animation: heroLineRise 1.6s var(--ease-editorial) forwards;
  }
  :global(body.intro-done) .hero__title .line:nth-child(1) { animation-delay: 0.25s; }
  :global(body.intro-done) .hero__title .line:nth-child(2) { animation-delay: 0.6s; }
  .hero__title .italic {
    font-family: var(--font-italic);
    font-style: italic;
    font-weight: 300;
  }
  @keyframes heroLineRise {
    0% {
      clip-path: inset(100% 0 0 0);
      -webkit-clip-path: inset(100% 0 0 0);
      filter: blur(6px);
      transform: translateY(8px);
    }
    60% {
      filter: blur(2px);
    }
    100% {
      clip-path: inset(0 0 0 0);
      -webkit-clip-path: inset(0 0 0 0);
      filter: blur(0);
      transform: translateY(0);
    }
  }

  /* ---------- EYEBROW ----------
   * The 28px line draws first (left → right), then the text fades in with a
   * soft letter-spacing release. Two coordinated reveals, very Hermès.
   */
  .hero__eyebrow {
    display: block;
    font-family: var(--font-sans);
    font-size: 10px;
    letter-spacing: 0.6em;
    text-transform: uppercase;
    font-weight: 400;
    color: rgba(247, 243, 236, 0);
    margin-top: 28px;
  }
  :global(body.intro-done) .hero__eyebrow {
    animation: heroEyebrowText 1s var(--ease-editorial) 1.5s forwards;
  }
  .hero__eyebrow::before {
    content: "";
    display: inline-block;
    width: 0;
    height: 1px;
    background: rgba(247, 243, 236, 0.5);
    vertical-align: middle;
    margin-right: 14px;
    margin-bottom: 3px;
  }
  :global(body.intro-done) .hero__eyebrow::before {
    animation: heroEyebrowLine 0.9s var(--ease-editorial) 1.15s forwards;
  }
  @keyframes heroEyebrowLine {
    to { width: 28px; }
  }
  @keyframes heroEyebrowText {
    to {
      color: rgba(247, 243, 236, 0.7);
      letter-spacing: 0.42em;
    }
  }

  /* ---------- CTAs ----------
   * Each button reveals with a horizontal mask sweep (clip-path inset right →
   * 0) + tiny lift. Stagger 0.15s between primary and ghost.
   */
  .hero__cta {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    margin-top: 36px;
  }
  /* Outer wrapper handles the entry mask reveal; inner element handles hover
   * transform. Decoupling avoids the keyframes-vs-hover transform conflict. */
  .hero__btn {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    padding: 16px 28px;
    font-family: var(--font-sans);
    font-size: 11.5px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    font-weight: 400;
    border: 1px solid currentColor;
    cursor: none;
    position: relative;
    overflow: hidden;
    clip-path: inset(0 100% 0 0);
    -webkit-clip-path: inset(0 100% 0 0);
    opacity: 0;
    transition: background 0.5s var(--ease-editorial),
      color 0.5s var(--ease-editorial),
      border-color 0.5s var(--ease-editorial),
      transform 0.5s var(--ease-soft);
  }
  :global(body.intro-done) .hero__btn {
    animation: heroBtnReveal 1.1s var(--ease-editorial) forwards;
  }
  :global(body.intro-done) .hero__cta a:nth-child(1) { animation-delay: 2.05s; }
  :global(body.intro-done) .hero__cta a:nth-child(2) { animation-delay: 2.2s; }
  @keyframes heroBtnReveal {
    to {
      clip-path: inset(0 0 0 0);
      -webkit-clip-path: inset(0 0 0 0);
      opacity: 1;
    }
  }
  .hero__btn svg {
    width: 14px;
    height: 14px;
    transition: transform 0.5s var(--ease-editorial);
  }
  .hero__btn:hover { transform: translateY(-2px); }
  .hero__btn:hover svg { transform: translateX(5px); }
  .hero__btn--primary {
    background: #f7f3ec;
    color: var(--color-ink);
    border-color: #f7f3ec;
  }
  .hero__btn--primary:hover {
    background: transparent;
    color: #f7f3ec;
  }
  .hero__btn--ghost {
    background: transparent;
    color: #f7f3ec;
    border-color: rgba(247, 243, 236, 0.5);
  }
  .hero__btn--ghost:hover {
    background: rgba(247, 243, 236, 0.08);
    border-color: #f7f3ec;
  }

  @media (max-width: 700px) {
    .hero__content { bottom: 9vh; left: 7vw; }
    .hero__eyebrow { margin-top: 22px; letter-spacing: 0.36em; }
    .hero__cta { margin-top: 28px; gap: 10px; }
    .hero__btn { padding: 14px 22px; font-size: 10.5px; letter-spacing: 0.24em; }
  }

  /* < 400px: stack the CTAs vertically full-width so neither button breaks
   * to two lines, and tap targets stay generous. */
  @media (max-width: 400px) {
    .hero__content {
      bottom: 6vh;
      left: 6vw;
      right: 6vw;
      max-width: none;
    }
    .hero__title { font-size: clamp(34px, 9vw, 48px); }
    .hero__cta {
      flex-direction: column;
      align-items: stretch;
      gap: 10px;
      width: 100%;
    }
    .hero__btn {
      justify-content: center;
      width: 100%;
    }
    .hero__progress { height: 2px; }
  }
</style>
