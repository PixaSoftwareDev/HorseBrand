---
import { type Lang, useTranslations } from "@/i18n/ui";
import Reveal from "@/components/shared/Reveal.astro";
import { cldImage } from "@/lib/cloudinary";
import { CLD_IDS } from "@/lib/cloudinaryAssets";

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
// Pieza editorial elegida por el cliente — acompaña la línea
// "Una marca que respira identidad ecuestre, cuero, carácter."
const manifestoImg = cldImage(CLD_IDS.IMG_3082, 1600);
---

<section class="manifesto" id="manifiesto">
  <div class="manifesto__grid">
    <div class="manifesto__text">
      <Reveal as="h2">
        <span>{t("manifesto.title_1")}</span>
        <em>{t("manifesto.title_2")}</em>
      </Reveal>
      <Reveal as="div" class="manifesto__body">
        <p>{t("manifesto.p1")}</p>
        <p>{t("manifesto.p2")}</p>

        <figure class="manifesto__pullquote">
          <span class="manifesto__pullquote-rule" aria-hidden="true"></span>
          <blockquote>{t("manifesto.quote")}</blockquote>
        </figure>

        <ol class="manifesto__list">
          <li><span class="num">01</span>{t("manifesto.li_1")}</li>
          <li><span class="num">02</span>{t("manifesto.li_2")}</li>
          <li><span class="num">03</span>{t("manifesto.li_3")}</li>
        </ol>
      </Reveal>
    </div>
    <Reveal class="manifesto__media">
      <div data-scroll-reveal>
        <img src={manifestoImg} alt={t("manifesto.caption")} loading="lazy" decoding="async" />
      </div>
      <figcaption class="manifesto__caption">{t("manifesto.caption")}</figcaption>
    </Reveal>
  </div>
</section>

<style>
  .manifesto {
    background: var(--color-paper);
    /* Padding 110 (era 140) · la sección deja de tomar autoridad con
     * peso vertical y se vuelve un capítulo editorial que pide su
     * scroll sin abusarlo. */
    padding: 110px 0;
  }
  .manifesto__grid {
    max-width: 1500px;
    margin: 0 auto;
    padding: 0 5vw;
    display: grid;
    /* 1fr 1fr · grid simétrico. Antes era 1.05/0.95 (texto ligeramente
     * más ancho) y la imagen se sentía angosta vs el peso del texto.
     * Con 50/50 la imagen recupera presencia editorial sin invertir
     * la jerarquía. */
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
  }
  /* Column ensanchada a 820px · suficiente para que "Una marca que
   * respira" entre en 1 línea al tamaño grande del título original.
   * Antes en 760 todavía wrappeaba a "Una marca que" + "respira". */
  .manifesto__text { max-width: 820px; }
  .manifesto__text :global(h2) {
    margin: 22px 0 64px;
    /* Tamaño cap 64 (era 4.5vw cap 72 en el global, pero a 72 no
     * entraba). 64 es lo más grande que garantiza "Una marca que
     * respira" en 1 línea sobre una column de 820px. */
    font-size: clamp(36px, 4.2vw, 64px);
    /* Line-height 1.14 (era 1.08) · los italics de Fraunces tienen
     * ascenders altos en "identidad ecuestre" + acentos en "carácter"
     * que se cortaban con el line-height tight. 1.14 deja respirar
     * sin abrir demasiado el bloque. */
    /* Line-height 1.14 (era 1.08) · los italics de Fraunces tienen
     * ascenders altos en "identidad ecuestre" y acentos en "carácter"
     * que necesitan respiración vertical. 1.14 aire sin abrir
     * demasiado el bloque. */
    line-height: 1.14;
    letter-spacing: 0;
    /* Padding solo vertical · top para acentos altos, bottom para
     * descenders y comas. El horizontal no hace falta porque el clip
     * de la animación de palabras en heroExit.ts ya respira 0.15em
     * a cada lado para alojar los overhangs del italic Fraunces. */
    padding: 0.14em 0 0.22em;
    /* Sin color override · hereda el ink-78% del global h1-h4 (el
     * tono "lujo silencioso" suave). Ponerle var(--color-ink) directo
     * lo volvía negro duro, perdía la respiración editorial. */
  }
  /* Span y em respetan el font-size del h2 (no lo overrideamos) · la
   * jerarquía se mantiene como en el diseño original: mismo peso,
   * mismo color, italic en el em.
   *
   * `white-space: nowrap` en el span garantiza que "Una marca que
   * respira" nunca rompe a 2 líneas, ni en viewports más chicos
   * (el clamp ya baja el font-size cuando el viewport es 1280 o
   * menos para que entre cómodo). */
  .manifesto__text :global(h2) span {
    display: inline;
    font-weight: 400;
    white-space: nowrap;
  }
  .manifesto__text :global(h2) em {
    display: block;
    font-family: var(--font-italic);
    font-style: italic;
    font-weight: 400;
  }
  :global(.manifesto__body) {
    margin-top: 8px;
  }
  .manifesto__body p {
    font-size: 16px;
    line-height: 1.75;
    color: rgba(21, 17, 13, 0.78);
    margin-bottom: 18px;
  }
  .manifesto__body p:first-child { margin-top: 0; }
  /* Pull quote — the manifesto signature line. Centered, italic, prominent.
   * Stands as the emotional anchor of the section, with a short gold rule
   * above and generous breathing room below. */
  .manifesto__pullquote {
    margin: 48px 0 12px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 22px;
  }
  .manifesto__pullquote-rule {
    display: block;
    width: 48px;
    height: 1px;
    background: var(--color-cognac);
  }
  .manifesto__pullquote blockquote {
    margin: 0;
    padding: 0;
    font-family: var(--font-italic);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(28px, 3.2vw, 44px);
    line-height: 1.2;
    letter-spacing: 0.005em;
    /* Ink-78% (era cognac) · el cognac competía con el em italic del
     * título "identidad ecuestre, cuero, carácter." que ya es cognac.
     * Dos italics marrones consecutivos sobrecargaban la sección.
     * Ahora la pullquote es un susurro gris (coherente con su mensaje
     * "lujo que no grita") y el cognac queda reservado al acento del
     * título — un solo gesto cromático por bloque. */
    color: rgba(21, 17, 13, 0.78);
    max-width: 440px;
  }

  /* Numbered list — editorial 01/02/03 in gold instead of cognac dots.
   * Same hairline structure but the number replaces the dot, giving each
   * row a chapter feel that matches the rest of the design system. */
  .manifesto__list {
    list-style: none;
    margin-top: 40px;
    padding: 0;
    counter-reset: manifesto-pillar;
  }
  .manifesto__list li {
    display: flex;
    align-items: center;
    gap: 22px;
    padding: 18px 0;
    border-top: 1px solid var(--line);
    font-family: var(--font-sans);
    font-size: 13px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-stone);
    transition: padding-left 0.45s var(--ease-editorial), color 0.4s;
  }
  .manifesto__list li:last-child { border-bottom: 1px solid var(--line); }
  .manifesto__list li:hover {
    padding-left: 6px;
    color: var(--color-ink);
  }
  .manifesto__list .num {
    flex-shrink: 0;
    font-family: var(--font-sans);
    font-size: 11px;
    letter-spacing: 0.36em;
    font-weight: 400;
    color: var(--color-gold);
    /* Reset any inherited dot styles from earlier markup. */
    width: auto;
    height: auto;
    background: transparent;
    border-radius: 0;
    min-width: 30px;
  }

  /* Editorial caption under the image — small caps with stone tone. */
  :global(.manifesto__media) {
    display: flex;
    flex-direction: column;
  }
  .manifesto__caption {
    margin-top: 18px;
    font-family: var(--font-sans);
    font-size: 10.5px;
    letter-spacing: 0.34em;
    text-transform: uppercase;
    color: var(--color-stone);
    align-self: flex-start;
  }

  /* Wrapper clips the scaling image so the Ken Burns motion stays inside. */
  .manifesto__media :global([data-scroll-reveal]) {
    overflow: hidden;
  }
  .manifesto__media :global(img) {
    width: 100%;
    /* Aspect 1:1 · ratio cuadrado moderno. Reemplaza la altura fija
     * 600px que dejaba la imagen en una proporción ambigua (~1.18:1).
     * Con 1:1, el alto matchea automáticamente el ancho del column —
     * a ~710px en desktop. Visualmente decide: "esto es un cuadrado",
     * no "esto es un rectángulo entre tamaños". */
    aspect-ratio: 1 / 1;
    height: auto;
    object-fit: cover;
    /* Slow contemplative Ken Burns — scales from 1.02 to 1.07 with a tiny
     * translate over 22s, alternating. Marks elegance without distracting. */
    animation: manifestoKenBurns 22s var(--ease-soft) infinite alternate;
    transform-origin: 50% 50%;
    will-change: transform;
  }
  @keyframes manifestoKenBurns {
    0%   { transform: scale(1.02) translate(0%, 0%); }
    100% { transform: scale(1.07) translate(-1%, 0.6%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .manifesto__media :global(img) { animation: none; transform: none; }
  }

  @media (max-width: 1280px) {
    .manifesto { padding: 90px 0; }
    .manifesto__grid { gap: 56px; }
  }
  @media (max-width: 900px) {
    .manifesto { padding: 80px 0; }
    .manifesto__grid { grid-template-columns: 1fr; gap: 50px; }
    /* En mobile el column es full-width — un 1:1 a 100vw sería
     * imponente de más. Mantenemos aspect-ratio pero un toque más
     * landscape (5:4) para que no abuse del scroll. */
    .manifesto__media :global(img) { aspect-ratio: 5 / 4; }
  }
  @media (max-width: 500px) {
    .manifesto { padding: 64px 0; }
    .manifesto__grid { gap: 36px; }
    .manifesto__list { margin-top: 28px; }
    .manifesto__list li { font-size: 12px; gap: 14px; padding: 14px 0; }
  }
</style>
