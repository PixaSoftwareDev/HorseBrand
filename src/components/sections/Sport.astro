---
import { type Lang, useTranslations } from "@/i18n/ui";
import Reveal from "@/components/shared/Reveal.astro";
import { cldImage } from "@/lib/cloudinary";
import { CLD_IDS } from "@/lib/cloudinaryAssets";

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);

// Foto editorial del jinete · imagen real del cliente.
const sportImg = cldImage(CLD_IDS.SPORT_HERO, 1400);
---

<section class="sport" id="deporte">
  <div class="sport__grid">
    <!-- IMAGEN a la izquierda · invierte el flow de Manifesto
         (que tiene texto-izq, imagen-der) para crear variación
         editorial tipo flip-page. -->
    <Reveal class="sport__media">
      <div data-scroll-reveal>
        <img src={sportImg} alt={t("sport.eyebrow")} loading="lazy" decoding="async" />
      </div>
      <figcaption class="sport__caption">{t("sport.caption")}</figcaption>
    </Reveal>

    <div class="sport__text">
      <Reveal class="eyebrow">{t("sport.eyebrow")}</Reveal>
      <Reveal as="h2">
        <span>{t("sport.title_1")}</span>
        <em>{t("sport.title_2")}</em>
      </Reveal>
      <Reveal as="div" class="sport__body">
        <p>{t("sport.body_1")}</p>
        <p>{t("sport.body_2")}</p>
      </Reveal>
    </div>
  </div>
</section>

<style>
  /* Sport · editorial sobre paper, layout 2-col (foto izq / texto der).
   * Coherente con Manifesto que está arriba (mismo paper, mismo grid
   * pattern) pero con la imagen invertida — variación tipo flip-page
   * que evita que dos secciones consecutivas se sientan iguales.
   * Caballo abajo cierra el díptico con su full-bleed cinematográfico. */
  .sport {
    background: var(--color-paper);
    padding: 110px 0;
  }

  .sport__grid {
    max-width: 1500px;
    margin: 0 auto;
    padding: 0 5vw;
    display: grid;
    /* Imagen primero (izq), texto segundo (der) · invierte Manifesto. */
    grid-template-columns: 0.95fr 1.05fr;
    gap: 80px;
    align-items: center;
  }

  /* ---- Media · imagen contenida, mismo tratamiento que Manifesto ---- */
  :global(.sport__media) {
    display: flex;
    flex-direction: column;
  }
  .sport__media :global([data-scroll-reveal]) {
    overflow: hidden;
  }
  .sport__media :global(img) {
    width: 100%;
    height: 600px;
    object-fit: cover;
    object-position: center 40%;
    animation: sportKenBurns 22s var(--ease-soft) infinite alternate;
    transform-origin: 50% 50%;
    will-change: transform;
  }
  @keyframes sportKenBurns {
    0%   { transform: scale(1.02) translate(0%, 0%); }
    100% { transform: scale(1.06) translate(0.8%, -0.5%); }
  }
  .sport__caption {
    margin-top: 18px;
    font-family: var(--font-sans);
    font-size: 10.5px;
    letter-spacing: 0.34em;
    text-transform: uppercase;
    color: var(--color-stone);
    align-self: flex-start;
  }

  /* ---- Texto · columna derecha ---- */
  .sport__text { max-width: 560px; }
  .sport__text :global(h2) {
    margin: 22px 0 48px;
    font-size: clamp(36px, 4.2vw, 60px);
    line-height: 1.08;
    letter-spacing: -0.005em;
    padding-bottom: 0.18em;
  }
  .sport__text :global(h2) span {
    display: inline;
    font-weight: 400;
    white-space: nowrap;
  }
  .sport__text :global(h2) em {
    display: block;
    font-family: var(--font-italic);
    font-style: italic;
    font-weight: 400;
  }

  :global(.sport__body) {
    margin-top: 8px;
  }
  .sport__body p {
    font-size: 16px;
    line-height: 1.75;
    color: rgba(21, 17, 13, 0.78);
    margin-bottom: 18px;
  }
  .sport__body p:first-child { margin-top: 0; }
  .sport__body p:last-child { margin-bottom: 0; }

  /* ---- Responsive ---- */
  @media (prefers-reduced-motion: reduce) {
    .sport__media :global(img) { animation: none; transform: none; }
  }

  @media (max-width: 1280px) {
    .sport { padding: 90px 0; }
    .sport__grid { gap: 56px; }
    .sport__media :global(img) { height: 500px; }
  }
  @media (max-width: 900px) {
    .sport { padding: 80px 0; }
    .sport__grid {
      grid-template-columns: 1fr;
      gap: 50px;
    }
    .sport__media :global(img) { height: 420px; }
  }
  @media (max-width: 500px) {
    .sport { padding: 64px 0; }
    .sport__grid { gap: 36px; }
    .sport__media :global(img) { height: 340px; }
  }
</style>
