---
import { type Lang, useTranslations } from "@/i18n/ui";

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<button class="shop-handle" id="shopHandle" aria-label={t("shop.handle")} aria-controls="shopDrawer">
  <span class="shop-handle__dot"></span>
  <span class="shop-handle__label">{t("shop.handle")}</span>
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true">
    <path d="M5 12h14M13 5l7 7-7 7"/>
  </svg>
</button>

<style>
  .shop-handle {
    position: fixed;
    top: 50%;
    right: 0;
    /* Default hidden · la chip arranca fuera del viewport y solo aparece
     * una vez que el Hero queda atrás (body.past-hero). Antes era siempre
     * visible — competía visualmente con el lockup del Hero. */
    transform: translateY(-50%) translateX(60%);
    opacity: 0;
    pointer-events: none;
    z-index: 90;
    /* Marrón del logo (HB_main_positivo) — matchea exacto la firma de
     * la marca. Antes era ink genérico; ahora la chip lee como "parte
     * del lockup" en lugar de "elemento accesorio". */
    background: #5e4234;
    color: var(--color-ivory);
    border: 0;
    cursor: none;
    padding: 22px 12px 22px 14px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    border-top-left-radius: 4px;
    border-bottom-left-radius: 4px;
    box-shadow: -2px 6px 28px rgba(94, 66, 52, 0.28);
    transition: background 0.45s, transform 0.55s var(--ease-editorial),
      box-shadow 0.5s, opacity 0.5s;
  }
  /* Revealed once the Hero leaves the viewport · script abajo dispara la
   * clase. Slide-in desde la derecha + fade. */
  :global(body.past-hero) .shop-handle {
    transform: translateY(-50%) translateX(0);
    opacity: 1;
    pointer-events: auto;
  }
  .shop-handle:hover {
    background: var(--color-ink);
    box-shadow: -2px 8px 36px rgba(15, 11, 8, 0.32);
  }
  .shop-handle__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-gold);
    box-shadow: 0 0 0 3px rgba(176, 133, 82, 0.18);
    animation: shopPulse 2.6s ease-in-out infinite;
  }
  @keyframes shopPulse {
    0%, 100% { box-shadow: 0 0 0 3px rgba(176, 133, 82, 0.16); }
    50% { box-shadow: 0 0 0 7px rgba(176, 133, 82, 0); }
  }
  .shop-handle__label {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    font-family: var(--font-sans);
    font-size: 11px;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    font-weight: 400;
  }
  .shop-handle svg {
    width: 14px;
    height: 14px;
    transform: rotate(90deg);
  }

  /* Hide while drawer is open · igual fuerza la salida aunque past-hero
   * esté activa (la clase shop-open viene después en orden de cascada). */
  :global(body.shop-open) .shop-handle {
    transform: translateY(-50%) translateX(110%);
    opacity: 0;
    pointer-events: none;
  }

  @media (max-width: 700px) {
    .shop-handle { padding: 16px 10px 16px 12px; gap: 10px; }
    .shop-handle__label { font-size: 10px; letter-spacing: 0.32em; }
  }

  /* On phones the always-visible handle eats edge space + competes with the
   * cart icon already in the nav. Drop it under 600px and rely on the nav
   * cart for shop entry. */
  @media (max-width: 600px) {
    .shop-handle { display: none; }
  }
</style>

<script>
  import { onPageReady } from "@/lib/onPageReady";

  function wireShopHandle(): void {
    const handle = document.getElementById("shopHandle");
    if (!handle) return;
    handle.addEventListener("click", () => {
      window.dispatchEvent(new CustomEvent("shop:open"));
    });

    /* Reveal logic · la chip arranca oculta y se muestra recién cuando
     * el Hero deja el viewport. IntersectionObserver mira `.hero` con
     * threshold 0 — `isIntersecting` es false en cuanto el Hero queda
     * completamente arriba del fold. Al volver al Hero (scroll-up), se
     * vuelve a ocultar. Si no encuentra el Hero (rutas internas sin
     * landing), revela inmediatamente para no dejar la chip oculta. */
    const hero = document.querySelector<HTMLElement>(".hero");
    if (!hero) {
      document.body.classList.add("past-hero");
      return;
    }
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          document.body.classList.toggle("past-hero", !e.isIntersecting);
        });
      },
      { threshold: 0 }
    );
    io.observe(hero);

    document.addEventListener(
      "astro:before-swap",
      () => {
        io.disconnect();
        document.body.classList.remove("past-hero");
      },
      { once: true }
    );
  }
  onPageReady(wireShopHandle);
</script>
