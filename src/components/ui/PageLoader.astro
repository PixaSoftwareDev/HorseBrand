---
import { Image } from "astro:assets";
import logoMain from "@/assets/logo/logo-main.png";
---

<div id="pageLoader" class="loader" aria-hidden="true" role="status">
  <div class="loader__inner">
    <div class="loader__logo">
      <Image src={logoMain} alt="" widths={[240, 480]} sizes="240px" loading="eager" />
    </div>
    <div class="loader__bar"><span></span></div>
  </div>
</div>

<style>
  .loader {
    position: fixed;
    inset: 0;
    z-index: 10000;
    background: #000;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: none;
    transition: opacity 0.7s var(--ease-editorial);
  }
  .loader.is-out {
    opacity: 0;
    pointer-events: none;
  }
  :global(body.loader-done) .loader { display: none; }

  .loader__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 28px;
  }
  .loader__logo {
    animation: loaderPulse 2.4s var(--ease-soft) infinite;
  }
  .loader__logo :global(img) {
    height: 22vmin;
    max-height: 200px;
    width: auto;
    filter: brightness(0) invert(1);
    opacity: 0.92;
    user-select: none;
  }
  .loader__bar {
    width: 88px;
    height: 1px;
    background: rgba(247, 243, 236, 0.14);
    overflow: hidden;
    position: relative;
  }
  .loader__bar span {
    position: absolute;
    inset: 0;
    background: rgba(247, 243, 236, 0.85);
    transform: scaleX(0);
    transform-origin: left center;
    animation: loaderBar 1.6s cubic-bezier(0.65, 0, 0.35, 1) infinite;
  }
  @keyframes loaderPulse {
    0%, 100% { opacity: 0.82; transform: scale(1); }
    50% { opacity: 1; transform: scale(1.04); }
  }
  @keyframes loaderBar {
    0%   { transform-origin: left center;  transform: scaleX(0); }
    50%  { transform-origin: left center;  transform: scaleX(1); }
    50.01% { transform-origin: right center; }
    100% { transform-origin: right center; transform: scaleX(0); }
  }
</style>

<script>
  const MIN_MS = 650;

  function dismissLoader(): void {
    const el = document.getElementById("pageLoader");
    if (!el) {
      document.body.classList.add("loader-done");
      document.body.dispatchEvent(new CustomEvent("hb:loader-done"));
      return;
    }
    el.classList.add("is-out");
    el.addEventListener(
      "transitionend",
      () => {
        document.body.classList.add("loader-done");
        document.body.dispatchEvent(new CustomEvent("hb:loader-done"));
      },
      { once: true }
    );
  }

  function bootLoader(): void {
    // Subsequent SPA navigations: loader already dismissed, hide instantly.
    if (document.body.classList.contains("loader-done")) {
      const el = document.getElementById("pageLoader");
      if (el) el.style.display = "none";
      return;
    }

    const start = performance.now();
    const finalize = (): void => {
      const elapsed = performance.now() - start;
      const wait = Math.max(0, MIN_MS - elapsed);
      window.setTimeout(dismissLoader, wait);
    };
    if (document.readyState === "complete") finalize();
    else window.addEventListener("load", finalize, { once: true });
  }

  bootLoader();
  document.addEventListener("astro:page-load", bootLoader);
</script>
