---
import "@/styles/global.css";
import { ClientRouter } from "astro:transitions";
import Nav from "@/components/nav/Nav.astro";
import MobileMenu from "@/components/nav/MobileMenu.astro";
import Cursor from "@/components/ui/Cursor.astro";
import SectionMarker from "@/components/ui/SectionMarker.astro";
import Lightbox from "@/components/ui/Lightbox.astro";
import IntroSplash from "@/components/ui/IntroSplash.astro";
import PageLoader from "@/components/ui/PageLoader.astro";
import ShopHandle from "@/components/shop/ShopHandle.astro";
import ShopDrawer from "@/components/shop/ShopDrawer.astro";
import { type Lang, useTranslations } from "@/i18n/ui";
import { cldOgImage } from "@/lib/cloudinary";

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
}

const { lang, title, description } = Astro.props;
const t = useTranslations(lang);
const finalTitle = title ?? "Lifestyle Equestrian";
const finalDesc = description ?? t("hero.sub");

// Build canonical + alternate URLs from the configured site origin and the
// current pathname (without locale prefix so we can derive both ES and EN).
const origin = Astro.site?.toString().replace(/\/$/, "") ?? "";
const path = Astro.url.pathname;
const pathNoLang = path.replace(/^\/en\//, "/").replace(/^\/en$/, "/");
const canonicalUrl = `${origin}${path}`;
const esUrl = `${origin}${pathNoLang}`;
const enUrl = `${origin}${pathNoLang === "/" ? "/en/" : `/en${pathNoLang}`}`;

// Open Graph image: a hero editorial shot (already on Cloudinary), reformatted
// to 1200×630 — the standard for Facebook / LinkedIn / Twitter previews.
const ogImage = cldOgImage("v1778360931/IMG_2955_mo2hsl.jpg");
const ogLocale = lang === "en" ? "en_US" : "es_AR";
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, minimum-scale=1, user-scalable=no, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <title>{finalTitle}</title>
    <meta name="description" content={finalDesc} />

    <!-- Canonical + i18n alternates -->
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="es" href={esUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={esUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={finalTitle} />
    <meta property="og:description" content={finalDesc} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:site_name" content="Horse Brand" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={finalTitle} />
    <meta name="twitter:description" content={finalDesc} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" type="image/svg+xml" href="https://res.cloudinary.com/dukv3ov6t/image/upload/e_trim:100,c_fill,g_center,w_64,h_64/v1778936977/HB_lite_positivo_nopab6.svg" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="https://res.cloudinary.com/dukv3ov6t/image/upload/f_png,e_trim:100,c_fill,g_center,w_64,h_64/v1778936977/HB_lite_positivo_nopab6.svg" />
    <link rel="icon" type="image/png" sizes="192x192" href="https://res.cloudinary.com/dukv3ov6t/image/upload/f_png,e_trim:100,c_fill,g_center,w_384,h_384/v1778936977/HB_lite_positivo_nopab6.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="https://res.cloudinary.com/dukv3ov6t/image/upload/f_png,e_trim:100,c_fill,g_center,w_360,h_360/v1778936977/HB_lite_positivo_nopab6.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Fraunces (editorial display + italic with swashes; variable opsz,
         wght, SOFT) + Inter (modern UI sans). Replaces the previous
         Cormorant Garamond / Jost pair which had become the "free luxe
         template" cliché — see tokens.css for the brief and reasoning. -->
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght,SOFT@0,9..144,300..700,0..100;1,9..144,300..700,0..100&family=Inter:wght@300..600&display=swap"
    />
    <ClientRouter />
  </head>
  <body>
    <PageLoader />
    <IntroSplash lang={lang} />
    <Cursor />
    <SectionMarker lang={lang} />
    <Nav lang={lang} />
    <MobileMenu lang={lang} />

    <main>
      <slot />
    </main>

    <audio id="ambientAudio" preload="auto" loop>
      <source src="/audio/ambient.mp3" type="audio/mpeg" />
    </audio>

    <Lightbox />
    <ShopHandle lang={lang} />
    <ShopDrawer lang={lang} />

    <script>
      import { initAmbientAudio } from "@/lib/audio";
      import { initReveal } from "@/lib/reveal";
      import { initScrollReveal } from "@/lib/scrollReveal";
      import { initCursor, initNavScrollState, initSmoothAnchors } from "@/lib/cursor";
      import { initLenis } from "@/lib/lenis";
      import { initHeroExit } from "@/lib/heroExit";
      import { initSectionMarker } from "@/lib/sectionMarker";
      import { onPageReady } from "@/lib/onPageReady";

      function bootstrap(): void {
        // Lenis first: it owns the rAF ticker that GSAP ScrollTrigger and any
        // future scroll-coupled timeline reads from. Booting it before the
        // other modules means initSmoothAnchors picks up the live instance
        // when it routes anchor clicks through lenisScrollTo.
        initLenis();
        initCursor();
        initNavScrollState();
        initSmoothAnchors();
        initReveal();
        initScrollReveal();
        initAmbientAudio();
        initSectionMarker();
        // Hero → Manifesto envolvente. Internally defers itself until the
        // IntroSplash dispatches "hb:intro-done" so the pin starts from the
        // Hero's settled post-intro state, not its pre-animation snapshot.
        initHeroExit();
      }

      onPageReady(bootstrap);
    </script>
  </body>
</html>
