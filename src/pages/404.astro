---
import Base from "@/layouts/Base.astro";
import { getLangFromUrl } from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);

const copy = lang === "en"
  ? {
      title: "404 · Horse Brand",
      description: "The page you're looking for is not in our atelier. Return to Horse Brand.",
      eyebrow: "404",
      h1_a: "This piece",
      h1_b: "doesn't exist yet.",
      p: "The page you're looking for is not in our atelier.",
      cta: "Back to home",
      home: "/en/",
    }
  : {
      title: "404 · Horse Brand",
      description: "La página que buscás no se encuentra en nuestro atelier. Volvé a Horse Brand.",
      eyebrow: "404",
      h1_a: "Esta pieza",
      h1_b: "aún no existe.",
      p: "La página que buscas no se encuentra en nuestro atelier.",
      cta: "Volver al inicio",
      home: "/",
    };
---

<Base lang={lang} title={copy.title}>
  <section class="notfound">
    <div>
      <span class="eyebrow">{copy.eyebrow}</span>
      <h1>{copy.h1_a}<br /><em>{copy.h1_b}</em></h1>
      <p>{copy.p}</p>
      <a href={copy.home} class="btn btn--dark">
        {copy.cta}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1">
          <path d="M5 12h14M13 5l7 7-7 7" />
        </svg>
      </a>
    </div>
  </section>
</Base>

<style>
  .notfound {
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 0 7vw;
    background: var(--color-paper);
  }
  .notfound > div { max-width: 640px; display: flex; flex-direction: column; align-items: center; gap: 24px; }
  .notfound h1 {
    font-family: var(--font-italic);
    font-weight: 400;
    font-size: clamp(54px, 7vw, 110px);
    line-height: 1.05;
    margin-top: 16px;
  }
  .notfound h1 em {
    font-style: italic;
    font-weight: 300;
    color: var(--color-cognac);
  }
  .notfound p {
    color: rgba(21, 17, 13, 0.65);
    font-size: 16px;
    line-height: 1.6;
    max-width: 420px;
  }
</style>
