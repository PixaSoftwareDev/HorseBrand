---
import Base from "@/layouts/Base.astro";
import Hero from "@/components/sections/Hero.astro";
import Manifesto from "@/components/sections/Manifesto.astro";
import Sport from "@/components/sections/Sport.astro";
import Caballo from "@/components/sections/Caballo.astro";
import Universe from "@/components/sections/Universe.astro";
import Craft from "@/components/sections/Craft.astro";
import Collection from "@/components/sections/Collection.astro";
import Gallery from "@/components/sections/Gallery.astro";
import Heritage from "@/components/sections/Heritage.astro";
import Contact from "@/components/sections/Contact.astro";
import Footer from "@/components/sections/Footer.astro";

const lang = "en" as const;
---

<Base lang={lang}>
  <Hero lang={lang} />
  <Manifesto lang={lang} />
  <Sport lang={lang} />
  <Caballo lang={lang} />
  <Universe lang={lang} />
  <Craft lang={lang} />
  <Collection lang={lang} />
  <Gallery lang={lang} />
  <Heritage lang={lang} />
  <Contact lang={lang} />
  <Footer lang={lang} />
</Base>
